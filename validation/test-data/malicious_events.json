{
  "description": "Malicious events for true positive testing",
  "version": "1.0",
  "test_cases": [
    {
      "name": "SSH brute force attack",
      "type": "brute_force",
      "severity": "high",
      "input": {
        "timestamp": "2024-01-15T10:40:00Z",
        "srcip": "203.0.113.15",
        "user": "admin",
        "event_type": "authentication",
        "status": "failure",
        "service": "sshd",
        "attempt_count": 15,
        "message": "authentication failure; logname= uid=0 euid=0 tty=ssh ruser= rhost=203.0.113.15"
      },
      "expected": true,
      "description": "Multiple failed SSH authentication attempts should trigger alerts"
    },
    {
      "name": "SQL injection attempt",
      "type": "injection",
      "severity": "critical",
      "input": {
        "timestamp": "2024-01-15T10:41:00Z",
        "srcip": "198.51.100.25",
        "method": "POST",
        "url": "/login.php",
        "post_data": "username=admin' OR 1=1--&password=test",
        "status_code": 500,
        "user_agent": "sqlmap/1.0",
        "message": "POST /login.php - SQL injection detected in parameters"
      },
      "expected": true,
      "description": "SQL injection attempts should trigger alerts"
    },
    {
      "name": "Directory traversal attack",
      "type": "path_traversal",
      "severity": "high",
      "input": {
        "timestamp": "2024-01-15T10:42:00Z",
        "srcip": "192.0.2.50",
        "method": "GET",
        "url": "/files/../../../../etc/passwd",
        "status_code": 403,
        "user_agent": "Mozilla/5.0 (compatible; Attack)",
        "message": "GET /files/../../../../etc/passwd - Directory traversal attempt blocked"
      },
      "expected": true,
      "description": "Directory traversal attempts should trigger alerts"
    },
    {
      "name": "Malware download attempt",
      "type": "malware",
      "severity": "critical",
      "input": {
        "timestamp": "2024-01-15T10:43:00Z",
        "srcip": "203.0.113.100",
        "method": "GET",
        "url": "/downloads/malware.exe",
        "status_code": 200,
        "file_hash": "d41d8cd98f00b204e9800998ecf8427e",
        "threat_score": 95,
        "message": "Malicious file download detected"
      },
      "expected": true,
      "description": "Malware downloads should trigger alerts"
    },
    {
      "name": "Privilege escalation attempt",
      "type": "privilege_escalation",
      "severity": "critical",
      "input": {
        "timestamp": "2024-01-15T10:44:00Z",
        "user": "guest",
        "command": "sudo su -",
        "target_user": "root",
        "status": "denied",
        "message": "Unauthorized privilege escalation attempt by guest user"
      },
      "expected": true,
      "description": "Unauthorized privilege escalation should trigger alerts"
    },
    {
      "name": "Suspicious file modification",
      "type": "file_tampering",
      "severity": "high",
      "input": {
        "timestamp": "2024-01-15T10:45:00Z",
        "file": "/etc/shadow",
        "operation": "modify",
        "user": "www-data",
        "previous_hash": "abc123def456",
        "new_hash": "def456abc123",
        "message": "Critical system file modified by web server process"
      },
      "expected": true,
      "description": "Unauthorized system file modifications should trigger alerts"
    },
    {
      "name": "Command injection attack",
      "type": "injection",
      "severity": "critical",
      "input": {
        "timestamp": "2024-01-15T10:46:00Z",
        "srcip": "198.51.100.75",
        "method": "POST",
        "url": "/system/ping.php",
        "post_data": "host=127.0.0.1; cat /etc/passwd",
        "status_code": 200,
        "message": "Command injection detected in ping parameter"
      },
      "expected": true,
      "description": "Command injection attempts should trigger alerts"
    },
    {
      "name": "Suspicious network scanning",
      "type": "reconnaissance",
      "severity": "medium",
      "input": {
        "timestamp": "2024-01-15T10:47:00Z",
        "srcip": "203.0.113.200",
        "scan_type": "port_scan",
        "ports_scanned": [22, 23, 80, 443, 8080, 3389],
        "scan_rate": 100,
        "duration": 30,
        "message": "High-speed port scan detected from external IP"
      },
      "expected": true,
      "description": "Network reconnaissance should trigger alerts"
    },
    {
      "name": "Data exfiltration attempt",
      "type": "data_exfiltration",
      "severity": "critical",
      "input": {
        "timestamp": "2024-01-15T10:48:00Z",
        "user": "intern",
        "operation": "bulk_download",
        "files_count": 5000,
        "total_size": "2.5GB",
        "destination": "external_ftp",
        "time_window": "5_minutes",
        "message": "Suspicious bulk file transfer to external location"
      },
      "expected": true,
      "description": "Large-scale data transfers should trigger alerts"
    },
    {
      "name": "Ransomware file encryption",
      "type": "ransomware",
      "severity": "critical",
      "input": {
        "timestamp": "2024-01-15T10:49:00Z",
        "process": "unknown_process.exe",
        "operation": "mass_file_encryption",
        "files_affected": 1500,
        "file_extensions": [".encrypted", ".locked"],
        "encryption_pattern": "AES-256",
        "message": "Mass file encryption detected - possible ransomware activity"
      },
      "expected": true,
      "description": "Ransomware activity should trigger critical alerts"
    },
    {
      "name": "Cryptocurrency mining process",
      "type": "cryptomining",
      "severity": "medium",
      "input": {
        "timestamp": "2024-01-15T10:50:00Z",
        "process": "xmrig",
        "cpu_usage": 98,
        "network_connections": ["pool.minexmr.com:4444"],
        "duration": 3600,
        "user": "nobody",
        "message": "Unauthorized cryptocurrency mining process detected"
      },
      "expected": true,
      "description": "Cryptocurrency mining should trigger alerts"
    },
    {
      "name": "Lateral movement attempt",
      "type": "lateral_movement",
      "severity": "high",
      "input": {
        "timestamp": "2024-01-15T10:51:00Z",
        "source_host": "workstation-01",
        "target_host": "server-03",
        "protocol": "SMB",
        "credentials": "admin",
        "status": "success",
        "tools": ["psexec", "wmic"],
        "message": "Suspicious remote execution on multiple hosts"
      },
      "expected": true,
      "description": "Lateral movement patterns should trigger alerts"
    }
  ]
}