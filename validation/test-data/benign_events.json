{
  "description": "Benign events for false positive testing",
  "version": "1.0",
  "test_cases": [
    {
      "name": "Normal SSH login success",
      "type": "authentication",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:30:00Z",
        "srcip": "192.168.1.100",
        "user": "admin",
        "event_type": "authentication",
        "status": "success",
        "service": "sshd",
        "message": "Accepted publickey for admin from 192.168.1.100 port 22 ssh2"
      },
      "expected": false,
      "description": "Successful SSH authentication should not trigger alerts"
    },
    {
      "name": "Normal web server access",
      "type": "web_access",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:31:00Z",
        "srcip": "192.168.1.101",
        "method": "GET",
        "url": "/index.html",
        "status_code": 200,
        "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "message": "GET /index.html HTTP/1.1 200 1024"
      },
      "expected": false,
      "description": "Normal web page access should not trigger alerts"
    },
    {
      "name": "System service restart",
      "type": "system",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:32:00Z",
        "service": "nginx",
        "action": "restart",
        "user": "root",
        "pid": 1234,
        "message": "nginx service restarted successfully"
      },
      "expected": false,
      "description": "Legitimate service restart should not trigger alerts"
    },
    {
      "name": "Regular file backup",
      "type": "file_operation",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:33:00Z",
        "operation": "copy",
        "source": "/home/user/documents/file.txt",
        "destination": "/backup/daily/file.txt",
        "user": "backup",
        "size": 1024,
        "message": "File backup completed successfully"
      },
      "expected": false,
      "description": "Scheduled backup operations should not trigger alerts"
    },
    {
      "name": "Database maintenance query",
      "type": "database",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:34:00Z",
        "database": "production",
        "query": "OPTIMIZE TABLE users",
        "user": "db_admin",
        "duration": 5.2,
        "rows_affected": 0,
        "message": "Database optimization completed"
      },
      "expected": false,
      "description": "Routine database maintenance should not trigger alerts"
    },
    {
      "name": "Automated system update",
      "type": "system_update",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:35:00Z",
        "update_type": "security_patch",
        "packages": ["openssl", "curl", "nginx"],
        "user": "system",
        "status": "completed",
        "message": "Security updates installed successfully"
      },
      "expected": false,
      "description": "Automated security updates should not trigger alerts"
    },
    {
      "name": "User session timeout",
      "type": "session",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:36:00Z",
        "user": "john.doe",
        "session_id": "abc123def456",
        "duration": 3600,
        "reason": "timeout",
        "message": "User session expired due to inactivity"
      },
      "expected": false,
      "description": "Normal session timeouts should not trigger alerts"
    },
    {
      "name": "Certificate renewal",
      "type": "certificate",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:37:00Z",
        "certificate": "www.example.com",
        "action": "renewal",
        "issuer": "LetsEncrypt",
        "valid_until": "2024-04-15T10:37:00Z",
        "message": "SSL certificate renewed successfully"
      },
      "expected": false,
      "description": "Automatic certificate renewals should not trigger alerts"
    },
    {
      "name": "Load balancer health check",
      "type": "health_check",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:38:00Z",
        "service": "web-server-1",
        "check_type": "http",
        "endpoint": "/health",
        "status": "healthy",
        "response_time": 0.05,
        "message": "Health check passed"
      },
      "expected": false,
      "description": "Successful health checks should not trigger alerts"
    },
    {
      "name": "Scheduled job execution",
      "type": "cron_job",
      "severity": "info",
      "input": {
        "timestamp": "2024-01-15T10:39:00Z",
        "job": "daily_reports",
        "user": "cron",
        "command": "/usr/bin/generate_reports.sh",
        "exit_code": 0,
        "duration": 45.2,
        "message": "Scheduled job completed successfully"
      },
      "expected": false,
      "description": "Successful cron job execution should not trigger alerts"
    }
  ]
}