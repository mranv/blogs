# Cloudflare Pages caching headers
# https://developers.cloudflare.com/pages/configuration/serving-pages/#headers

# Static Astro assets — immutable (content-hashed filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Favicons and icons
/favicon/*
  Cache-Control: public, max-age=86400

# Manifest and service worker
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# Security headers for all pages
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Baseline CSP: the directives that cannot break inline scripts (theme switch, JSON-LD,
  # islands). script-src is deliberately absent: locking it needs nonces or hashes.
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
