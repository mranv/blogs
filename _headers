# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  
# Cache images
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/*.png
  Cache-Control: public, max-age=31536000, immutable
  
/*.gif
  Cache-Control: public, max-age=31536000, immutable
  
/*.svg
  Cache-Control: public, max-age=31536000, immutable
  
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS
/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable
  
/_astro/*.js
  Cache-Control: public, max-age=31536000, immutable

# Cache video files
/*.mp4
  Cache-Control: public, max-age=86400

# HTML pages - shorter cache
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  
/
  Cache-Control: public, max-age=0, must-revalidate