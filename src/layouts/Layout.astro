---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "@fontsource/maple-mono/400.css";
import "@fontsource/maple-mono/500.css";
import "@fontsource/maple-mono/700.css";

// Design-system styles (tokens, components, prose, motion, glow/CRT)
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/scrollbar.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/transition.css";
import "../styles/photoswipe.css";
import "../styles/expressive-code.css";
import "../styles/glow.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import SEOEnhanced from "@components/SEOEnhanced.astro";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	image?: string;
	setOGTypeArticle?: boolean;
	articleData?: {
		published?: string | Date;
		modified?: string | Date;
		tags?: string[];
	};
}

let { title, banner, description, lang, image, setOGTypeArticle, articleData } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

// compute social preview image
let socialImage: string;
if (image && typeof image === 'string' && image.trim() !== '') {
	// if the provided image is absolute path, prefix with site
	if (image.startsWith('http://') || image.startsWith('https://')) {
		socialImage = image;
	} else {
		socialImage = `${Astro.site}${image.startsWith('/') ? image.slice(1) : image}`;
	}
} else {
	socialImage = `${Astro.site}${profileConfig.avatar.startsWith('/') ? profileConfig.avatar.slice(1) : profileConfig.avatar}`;
}

// compute article times if provided
const publishedTime = articleData?.published
	? (typeof articleData.published === 'string' ? articleData.published : articleData.published.toISOString())
	: undefined;
const modifiedTime = articleData?.modified
	? (typeof articleData.modified === 'string' ? articleData.modified : articleData.modified.toISOString())
	: undefined;

// helper: clamp description to ~155 chars without cutting words
function clampDescription(desc: string, max = 155) {
  if (!desc) return desc;
  const clean = desc.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut).trim() + '…';
}

// choose raw description: for articles, prefer the post description exactly; otherwise fallback to site tagline
const rawDescription = setOGTypeArticle && description ? description : (description || `${siteConfig.title} - ${siteConfig.subtitle}. Expert in DevSecOps, XDR/OXDR Platforms, Rust, eBPF, and Cloud-Native Security. 222+ Research Citations.`);
const metaDescription = clampDescription(rawDescription, 155);

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px] text-[var(--deep-text)]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="author" content={profileConfig.name}>
		<meta name="keywords" content={(articleData?.tags && articleData.tags.length > 0) ? articleData.tags.join(', ') : "Anubhav Gain, DevSecOps Expert, XDR Platform Architect, OXDR Security, Rust Programming, eBPF Development, Windows Kernel Security, EDR Platform, Leviathan Security Framework, Krustron Kubernetes, Agni Firecracker, Cloud Security, Kubernetes Security, Container Security, TechAnv Consulting, Infopercept Consulting, Security Software Engineer, MITRE ATT&CK, OpenSearch Rust SDK, Go Programming"}>

		<!-- Canonical URL -->
		<link rel="canonical" href={Astro.url} />

		<!-- Open Graph Tags -->
		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={metaDescription}>
		<meta property="og:locale" content={siteLang}>
		<meta property="og:image" content={socialImage}>
		<meta property="og:image:alt" content={title ? `${title}` : "Anubhav Gain - Security Software Engineer & Security Expert"}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
			{setOGTypeArticle ? (
	        <>
	          <meta property="og:type" content="article" />
	          <meta property="article:author" content={profileConfig.name} />
	          {publishedTime && <meta property="article:published_time" content={publishedTime} />}
	          {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
	          {(modifiedTime || publishedTime) && <meta property="og:updated_time" content={modifiedTime || publishedTime} />}
	          {Array.isArray(articleData?.tags) && articleData!.tags!.map(tag => (
	            <meta property="article:tag" content={tag} />
	          ))}
	        </>
	        ) : (
	        <>
	          <meta property="og:type" content="website" />
	        </>
	        )}

		<!-- Twitter Card Tags -->
		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:site" content="@AnubhavGain">
		<meta name="twitter:creator" content="@AnubhavGain">
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={metaDescription}>
		<meta name="twitter:image" content={socialImage}>
		<meta name="twitter:image:alt" content={title ? `${title}` : "Anubhav Gain - Security Software Engineer & Security Expert"}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- JSON-LD Structured Data for Anubhav Gain -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Anubhav Gain",
			"alternateName": "mranv",
			"jobTitle": "Security Software Engineer & CEO",
			"worksFor": [
				{
					"@type": "Organization",
					"name": "Infopercept Consulting",
					"url": "https://infopercept.com"
				},
				{
					"@type": "Organization",
					"name": "TechAnv Consulting",
					"description": "CEO and Founder"
				}
			],
			"description": "Security Software Engineer at Infopercept Consulting and CEO at TechAnv Consulting. Builder of Leviathan (Windows kernel-mode EDR/XDR framework in safe Rust), Krustron (open-source Kubernetes platform engineering alternative to Devtron), Agni (Firecracker microVM TUI), and OpenSearch Rust SDK. DevSecOps Expert, XDR/OXDR Platform Architect, Rust & eBPF Specialist. 222+ Research Citations.",
			"knowsAbout": [
				"DevSecOps",
				"XDR/OXDR Platform Architecture",
				"Rust Programming",
				"eBPF Development",
				"Windows Kernel Security (Ring 0)",
				"EDR/XDR Platform Development",
				"Cloud-Native Security",
				"Kubernetes Platform Engineering",
				"GitOps CI/CD",
				"Container Security",
				"Zero Trust Architecture",
				"SIEM Implementation",
				"MITRE ATT&CK Framework",
				"OCSF (Open Cybersecurity Schema Framework)",
				"Go Programming",
				"Linux Kernel Development",
				"OpenSearch SDK Development",
				"Firecracker microVMs",
				"Network Security Tools",
				"eBPF File Monitoring"
			],
			"alumniOf": {
				"@type": "EducationalOrganization",
				"name": "Professional Institution"
			},
			"url": Astro.site?.toString() || "https://mranv.pages.dev",
			"image": `${Astro.site}${profileConfig.avatar.startsWith('/') ? profileConfig.avatar.slice(1) : profileConfig.avatar}`,
			"sameAs": [
				"https://github.com/mranv",
				"https://github.com/anubhavg-icpl",
				"https://in.linkedin.com/in/anubhavgain",
				"https://www.instagram.com/anubhavgain/",
