			],
			"nationality": {
				"@type": "Country",
				"name": "India"
			},
			"award": "222+ Research Citations",
			"knowsLanguage": ["English", "Hindi"]
		})} />

		<!-- Website Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": siteConfig.title,
			"alternateName": "Anubhav Gain Blog",
			"url": Astro.site?.toString() || "https://mranv.pages.dev",
			"description": siteConfig.subtitle,
			"author": {
				"@type": "Person",
				"name": "Anubhav Gain"
			},
			"publisher": {
				"@type": "Person",
				"name": "Anubhav Gain"
			},
			"potentialAction": {
				"@type": "SearchAction",
				"target": {
					"@type": "EntryPoint",
					"urlTemplate": `${Astro.site}?search={search_term_string}`
				},
				"query-input": "required name=search_term_string"
			}
		})} />

		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// CRT overlay: default ON in dark mode, OFF in light; honor explicit localStorage pref.
			// Class lives on <html> (same as `dark`) because this runs in <head> before <body> exists.
			(function applyCrt() {
				const crtPref = localStorage.getItem('crt');
				const isDark = document.documentElement.classList.contains('dark');
				const crtOn = crtPref === null ? isDark : crtPref === 'on';
				if (crtOn) document.documentElement.classList.add('crt-on');
			})();


			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

		<!-- Enhanced SEO Components -->
		<SEOEnhanced title={title} description={description} />

		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<ConfigCarrier></ConfigCarrier>

		{/* CRT overlay — toggleable via body.crt-on (Footer button). Sits outside Swup's main container so it survives navigation. */}
		<div class="crt-overlay" aria-hidden="true">
			<div class="crt-overlay__scanlines"></div>
			<div class="crt-overlay__roll"></div>
			<div class="crt-overlay__vignette"></div>
			<div class="crt-overlay__flash"></div>
		</div>

		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}

@media (max-width: 480px) {
	.enable-banner.is-home #banner-wrapper,
	.enable-banner #banner-wrapper {
		height: 30vh;
	}
	.enable-banner.is-home #banner,
	.enable-banner #banner {
		height: 30vh;
	}
	.enable-banner #top-row {
		height: calc(30vh - 4.5rem);
	}
}

@media (min-width: 481px) and (max-width: 768px) {
	.enable-banner.is-home #banner-wrapper,
	.enable-banner #banner-wrapper {
		height: 38vh;
	}
	.enable-banner.is-home #banner,
	.enable-banner #banner {
		height: 38vh;
	}
	.enable-banner #top-row {
		height: calc(38vh - 4.5rem);
	}
}
</style>

