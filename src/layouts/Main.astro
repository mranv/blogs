---
import Breadcrumbs from "@components/Breadcrumbs.astro";

interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
---

<Breadcrumbs />
<main id="main-content" class="animate-fade-up">
  {
    "titleTransition" in props ? (
      <h1 class="text-reveal">
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="text-reveal">{props.pageTitle}</h1>
    )
  }
  <p class="animate-on-scroll">{props.pageDesc}</p>
  <div class="content-wrapper animate-on-scroll">
    <slot />
  </div>
</main>

<style>
  #main-content {
    @apply mx-auto w-full px-4 pb-4;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    #main-content {
      @apply px-6;
      max-width: 95%;
    }
  }

  @media (min-width: 768px) {
    #main-content {
      @apply px-8;
      max-width: 90%;
    }
  }

  @media (min-width: 1024px) {
    #main-content {
      max-width: 85%;
    }
  }

  @media (min-width: 1280px) {
    #main-content {
      max-width: 80%;
    }
  }

  @media (min-width: 1536px) {
    #main-content {
      max-width: 75%;
    }
  }

  #main-content h1 {
    @apply text-2xl font-semibold sm:text-3xl lg:text-4xl xl:text-5xl;
  }
  #main-content p {
    @apply mb-6 mt-2 italic text-sm sm:text-base lg:text-lg;
  }
</style>
