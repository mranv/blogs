---
import { LOGO_IMAGE, SITE, SOCIALS } from "@config";
import Hr from "./Hr.astro";
import NavigationMenuHeader from "./NavigationMenuHeader.tsx";
import { getCollection } from "astro:content";

export interface Props {
  activeNav?: "posts" | "tags" | "about" | "search";
}

const { activeNav } = Astro.props;

// Check for new posts (posts from last 7 days) for notification badge
const posts = await getCollection("blog");
const oneWeekAgo = new Date();
oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
const hasNewPosts = posts.some(
  post => new Date(post.data.pubDatetime) > oneWeekAgo
);
---

<header>
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="nav-container container">
    <div class="top-nav-wrap">
      <a href="/" class="logo whitespace-nowrap">
        {
          LOGO_IMAGE.enable ? (
            <img
              src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
              alt={SITE.title}
              width={LOGO_IMAGE.width}
              height={LOGO_IMAGE.height}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          ) : (
            SITE.title
          )
        }
      </a>
      <nav id="nav-menu" class="flex items-center">
        <NavigationMenuHeader
          client:load
          activeNav={activeNav}
          socialLinks={SOCIALS}
          hasNewPosts={hasNewPosts}
        />

        <!-- Logout Button -->
        <div class="ml-4">
          <button
            id="logoutBtn"
            class="auth-button-outline px-4 py-2 text-sm font-medium transition-all duration-200 hover:scale-105"
            title="Logout"
          >
            Logout
          </button>
        </div>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script>
  // Enhanced keyboard navigation for desktop navigation menu
  function enhanceKeyboardNavigation() {
    const navTriggers = document.querySelectorAll(
      "[data-radix-navigation-menu-trigger]"
    );

    navTriggers.forEach((trigger, index) => {
      trigger.addEventListener("keydown", e => {
        const event = e as KeyboardEvent;

        switch (event.key) {
          case "ArrowRight":
            event.preventDefault();
            const nextTrigger = navTriggers[index + 1] || navTriggers[0];
            (nextTrigger as HTMLElement).focus();
            break;
          case "ArrowLeft":
            event.preventDefault();
            const prevTrigger =
              navTriggers[index - 1] || navTriggers[navTriggers.length - 1];
            (prevTrigger as HTMLElement).focus();
            break;
        }
      });
    });
  }

  // Global keyboard shortcuts
  function setupGlobalShortcuts() {
    document.addEventListener("keydown", e => {
      // Search shortcut (Cmd+K or Ctrl+K)
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        window.location.href = "/search/";
      }

      // Escape to close any open navigation menus
      if (e.key === "Escape") {
        const openTriggers = document.querySelectorAll(
          '[data-radix-navigation-menu-trigger][data-state="open"]'
        );
        openTriggers.forEach(trigger => {
          (trigger as HTMLElement).click();
        });
      }
    });
  }

  enhanceKeyboardNavigation();
  setupGlobalShortcuts();

  // Logout functionality
  const logoutBtn = document.getElementById("logoutBtn");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", () => {
      localStorage.removeItem("isAuthenticated");
      localStorage.removeItem("userEmail");
      window.location.href = "/login";
    });
  }

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    enhanceKeyboardNavigation();
    setupGlobalShortcuts();

    // Re-attach logout functionality after navigation
    const logoutBtn = document.getElementById("logoutBtn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", () => {
        localStorage.removeItem("isAuthenticated");
        localStorage.removeItem("userEmail");
        window.location.href = "/login";
      });
    }
  });
</script>
