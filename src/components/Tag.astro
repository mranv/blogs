---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li
  class={`inline-block ${
    size === "sm" ? "my-1 underline-offset-4" : "my-3 mx-1 underline-offset-8"
  }`}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`${size === "sm" ? "text-sm" : "text-lg"} pr-2 group`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={`${size === "sm" ? "scale-75" : "scale-110"}`}
    >
      <path
        d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"
      ></path>
      <circle cx="7" cy="7" r="1"></circle>
    </svg>
    &nbsp;<span>{tag}</span>
  </a>
</li>

<style>
  li {
    @apply transition-all duration-300 hover:scale-105;
    display: inline-block !important;
    visibility: visible !important;
    margin: 0.25rem !important;
  }

  a {
    @apply relative inline-flex items-center px-3 py-1 rounded-full;
    @apply shadow-sm hover:shadow-md;
    @apply no-underline;

    display: inline-flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    min-height: 32px !important;
    align-items: center !important;

    /* Enhanced smooth transitions for theme switching */
    transition:
      color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.2s ease,
      box-shadow 0.3s ease;

    /* Light theme colors - Professional blue */
    color: rgb(37, 99, 235);
    background-color: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.3);
  }

  a:hover {
    background-color: rgba(37, 99, 235, 0.2);
    border-color: rgb(37, 99, 235);
    color: rgb(30, 64, 175);
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
  }

  a svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    margin-right: 0.5rem;
    display: inline-block;
    visibility: visible;
    opacity: 0.8;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  a span {
    font-weight: 500;
    display: inline-block;
    visibility: visible;
    opacity: 1;
    font-size: inherit;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Dark mode support with smooth transitions */
  :global(html[data-theme="dark"]) a {
    color: rgb(96, 165, 250);
    background-color: rgba(96, 165, 250, 0.15);
    border-color: rgba(96, 165, 250, 0.4);
  }

  :global(html[data-theme="dark"]) a:hover {
    background-color: rgba(96, 165, 250, 0.25);
    border-color: rgb(96, 165, 250);
    color: rgb(147, 197, 253);
    box-shadow: 0 4px 12px rgba(96, 165, 250, 0.2);
  }

  :global(html[data-theme="dark"]) a svg {
    color: rgb(96, 165, 250);
  }

  :global(html[data-theme="dark"]) a span {
    color: rgb(96, 165, 250);
  }

  /* Theme transition class support */
  :global(.theme-transition) a,
  :global(.theme-transition) a svg,
  :global(.theme-transition) a span {
    transition-duration: 0.4s !important;
  }
</style>
