---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li
  class={`inline-block ${
    size === "sm" ? "my-1 underline-offset-4" : "my-3 mx-1 underline-offset-8"
  }`}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`${size === "sm" ? "text-sm" : "text-lg"} pr-2 group`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={`${size === "sm" ? "scale-75" : "scale-110"}`}
    >
      <path
        d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"
      ></path>
      <circle cx="7" cy="7" r="1"></circle>
    </svg>
    &nbsp;<span>{tag}</span>
  </a>
</li>

<style>
  li {
    @apply transition-all duration-300 hover:scale-105;
    display: inline-block !important;
    visibility: visible !important;
    margin: 0.25rem !important;
  }

  a {
    @apply relative inline-flex items-center px-3 py-1 rounded-full;
    @apply transition-all duration-300;
    @apply shadow-sm hover:shadow-md;
    @apply no-underline;

    /* Explicit colors for visibility */
    color: rgb(37, 99, 235) !important; /* Professional blue */
    background-color: rgba(37, 99, 235, 0.1) !important;
    border: 1px solid rgba(37, 99, 235, 0.3) !important;

    display: inline-flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    min-height: 32px !important;
    align-items: center !important;
  }

  a:hover {
    background-color: rgba(37, 99, 235, 0.2) !important;
    border-color: rgb(37, 99, 235) !important;
    color: rgb(30, 64, 175) !important;
    transform: scale(1.05);
  }

  a svg {
    width: 16px !important;
    height: 16px !important;
    color: rgb(37, 99, 235) !important;
    stroke: currentColor !important;
    margin-right: 0.5rem !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 0.8 !important;
  }

  a span {
    font-weight: 500 !important;
    color: rgb(37, 99, 235) !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
    font-size: inherit !important;
  }

  /* Dark mode support */
  html[data-theme="dark"] a {
    color: rgb(96, 165, 250) !important;
    background-color: rgba(96, 165, 250, 0.1) !important;
    border-color: rgba(96, 165, 250, 0.3) !important;
  }

  html[data-theme="dark"] a:hover {
    background-color: rgba(96, 165, 250, 0.2) !important;
    border-color: rgb(96, 165, 250) !important;
    color: rgb(147, 197, 253) !important;
  }

  html[data-theme="dark"] a svg,
  html[data-theme="dark"] a span {
    color: rgb(96, 165, 250) !important;
  }
</style>
