---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li
  class={`inline-block ${
    size === "sm" ? "my-1 underline-offset-4" : "my-3 mx-1 underline-offset-8"
  }`}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`${size === "sm" ? "text-sm" : "text-lg"} pr-2 group`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={`${size === "sm" ? "scale-75" : "scale-110"}`}
    >
      <path
        d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"
      ></path>
      <circle cx="7" cy="7" r="1"></circle>
    </svg>
    &nbsp;<span>{tag}</span>
  </a>
</li>

<style>
  li {
    @apply transition-all duration-300 hover:scale-105;
    display: inline-block !important;
    visibility: visible !important;
  }

  a {
    @apply relative inline-flex items-center px-3 py-1 rounded-full;
    @apply text-skin-accent hover:text-skin-accent;
    @apply transition-all duration-300;
    @apply border border-skin-line hover:border-skin-accent;
    @apply shadow-sm hover:shadow-md;
    @apply no-underline;
    background: rgba(var(--color-accent), 0.1);
    display: inline-flex !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  a:hover {
    background: rgba(var(--color-accent), 0.2);
  }

  a::before {
    content: "";
    @apply absolute inset-0 rounded-full;
    @apply opacity-0 hover:opacity-100;
    @apply transition-opacity duration-300;
    background: linear-gradient(
      to right,
      rgba(var(--color-accent), 0.2),
      transparent
    );
    z-index: -1;
  }

  a svg {
    @apply h-4 w-4 text-skin-accent opacity-70 group-hover:opacity-100;
    @apply transition-all duration-300 group-hover:rotate-12;
    margin-right: 0.25rem;
    display: inline-block !important;
    visibility: visible !important;
  }

  a span {
    @apply font-medium;
    display: inline-block !important;
    visibility: visible !important;
  }
</style>
