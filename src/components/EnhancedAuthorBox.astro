---
import { SITE, SOCIALS } from "@config";

const authorName = "Anubhav Gain";
const authorImage = "/assets/gainsaheb.jpg";
---

<!-- Enhanced Author Box for better SEO and user engagement -->
<div
  class="author-box bg-card p-6 rounded-lg border border-border my-8 animate-fade-up"
  itemscope
  itemtype="https://schema.org/Person"
>
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4">
    <!-- Author Image -->
    <img
      src={authorImage}
      alt={`${authorName} - DevSecOps Engineer and Cybersecurity Expert`}
      class="w-24 h-24 rounded-full object-cover shadow-md"
      itemprop="image"
      width="96"
      height="96"
      loading="lazy"
    />

    <!-- Author Info -->
    <div class="flex-1 text-center sm:text-left">
      <h3 class="text-xl font-bold text-primary mb-2" itemprop="name">
        {authorName}
      </h3>
      <p class="text-sm text-muted-foreground mb-3" itemprop="jobTitle">
        DevSecOps Engineer & Cybersecurity Expert
      </p>

      <p
        class="text-sm text-foreground leading-relaxed mb-4"
        itemprop="description"
      >
        {authorName} is a leading DevSecOps Engineer specializing in cloud security
        automation, SIEM implementation, and enterprise security solutions. Expert
        in threat detection, security architecture, and DevSecOps practices with
        extensive experience in cybersecurity consulting.
      </p>

      <!-- Author Links -->
      <div class="flex flex-wrap justify-center sm:justify-start gap-3">
        {
          SOCIALS.filter(
            social =>
              social.active &&
              ["Github", "LinkedIn", "Twitter"].includes(social.name)
          ).map(social => (
            <a
              href={social.href}
              class="inline-flex items-center gap-2 text-xs bg-primary text-primary-foreground px-3 py-1 rounded-full hover:opacity-80 transition-opacity"
              target="_blank"
              rel="noopener noreferrer"
              itemprop="sameAs"
            >
              {social.name}
            </a>
          ))
        }
        <a
          href="/about/"
          class="inline-flex items-center gap-2 text-xs bg-background border border-border text-foreground px-3 py-1 rounded-full hover:bg-primary hover:text-primary-foreground transition-colors"
        >
          About {authorName}
        </a>
      </div>
    </div>
  </div>

  <!-- Structured Data for Author -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": `${SITE.website}#${authorName.toLowerCase().replace(" ", "-")}`,
      name: authorName,
      image: `${SITE.website}${authorImage}`,
      jobTitle: "DevSecOps Engineer",
      description: `${authorName} is a leading DevSecOps Engineer specializing in cloud security automation, SIEM implementation, and enterprise security solutions.`,
      url: `${SITE.website}about/`,
      sameAs: SOCIALS.filter(s => s.active).map(s => s.href),
      knowsAbout: [
        "DevSecOps",
        "Cybersecurity",
        "Cloud Security",
        "SIEM",
        "Security Automation",
        "Threat Detection",
      ],
    })}
  />
</div>

<style>
  .author-box {
    background: var(--color-card);
    border-color: var(--color-border);
  }

  .author-box:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
    transition: all 0.3s ease;
  }
</style>
