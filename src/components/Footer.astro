---

import { profileConfig, siteConfig } from "../config";
import ScrollVelocity from "./reactbits/ScrollVelocity";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const cols: [string, [string, string, boolean?][]][] = [
	["Read", [["Archive", url("archive/")], ["About", url("about/")], ["RSS", url("rss.xml")]]],
	["Site", [["Sitemap", url("sitemap-index.xml")], ["Privacy", url("privacy/")], ["Source", "https://github.com/mranv/blogs", true]]],
	// Skiper UI free tier requires attribution; see src/components/fx/ — do not remove.
	["Built with", [["Astro", "https://astro.build", true], ["Skiper UI", "https://skiper-ui.com", true], ["Animata", "https://animata.design", true], ["Vengeance UI", "https://www.vengenceui.com", true], ["React Bits", "https://reactbits.dev", true]]],
];
---

<footer class="mt-10 mb-12 mx-4 border-t border-[var(--line)] pt-10">
    <!-- Topic marquee (React Bits ScrollVelocity): speeds up with page scroll. Decorative. -->
    <div class="mb-10 text-[var(--ink-faint)]" aria-hidden="true">
        <ScrollVelocity client:visible texts={["Detection engineering · Rust · eBPF · Kernel · XDR ·"]} velocity={30} fontSize="1.5rem" fontWeight={400} scrollerClassName="!font-heading italic !drop-shadow-none" />
    </div>
    <div class="grid gap-8 sm:grid-cols-[1.4fr_repeat(3,1fr)]">
        <p class="font-heading italic text-2xl leading-tight text-90 max-w-[16ch]">{siteConfig.title}. Notes on security, Rust and the kernel.
            <!-- Hanko: the author's red seal, stamped down when the footer comes into view (public/ink-type.js) -->
            <span class="ink-seal" data-ink-stamp aria-hidden="true">AG</span></p>
        {cols.map(([head, links]) => (
            <div>
                <div class="eyebrow mb-3">{head}</div>
                <ul class="flex flex-col gap-1.5 text-sm">
                    {links.map(([name, href, ext]) => (
                        <li><a class="text-75 hover:text-[var(--ink)] underline-offset-4 hover:underline" href={href} target={ext ? "_blank" : null} rel={ext ? "noopener" : null}>{name}</a></li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
    <div class="mt-10 pt-4 border-t border-[var(--line-soft)] font-mono text-[0.5625rem] tracking-[0.2em] uppercase text-50">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name} · All rights reserved
        <!-- the reader's motion switch, reachable on phones too (the theme panel is desktop-only);
             the label shows the current state via html.ink-calm (Layout.astro) -->
        · <button type="button" class="uppercase tracking-[0.2em] hover:text-[var(--ink)] underline-offset-4 hover:underline" onclick="inkCalm.set(!inkCalm.get())"
                  aria-label="Toggle ink motion"><span class="calm-off">Motion: ink</span><span class="calm-on">Motion: calm</span></button>
    </div>
</footer>
