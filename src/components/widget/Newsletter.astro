---
// Newsletter subscription widget — TechAnV Corporate Branding
// Double opt-in via Cloudflare KV + email-sender Worker
// CAN-SPAM compliant: explicit consent, clear unsubscribe

import { Icon } from "astro-icon/components";

interface Props {
  heading?: string;
  description?: string;
  placeholder?: string;
  buttonLabel?: string;
  class?: string;
}

const {
  heading = "Newsletter",
  description = "Get updates on security engineering, Rust, eBPF, and DevSecOps. No spam, unsubscribe anytime.",
  placeholder = "you@example.com",
  buttonLabel = "Subscribe",
  class: className = "",
} = Astro.props;
---

<div
  id="newsletter-widget"
  class:list={["newsletter-widget card-base p-4", className]}
  data-endpoint="/api/subscribe"
>
  <!-- Header with TechAnV branding -->
  <div class="flex items-center gap-2.5 mb-2">
    <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--primary)] bg-opacity-10">
      <Icon name="material-symbols:mail-outline-rounded" class="text-[var(--primary)] text-lg" />
    </div>
    <div>
      <h3 class="font-bold text-sm text-90 m-0 leading-tight">{heading}</h3>
      <p class="text-[10px] text-30 m-0 font-medium tracking-wide uppercase">TechAnV Blog</p>
    </div>
  </div>
  <p class="text-xs text-50 mb-3 leading-relaxed">{description}</p>

  <!-- Form -->
  <form id="newsletter-form" class="newsletter-form" novalidate>
    <div class="flex gap-2">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder={placeholder}
        required
        autocomplete="email"
        aria-describedby="newsletter-hint newsletter-error"
        class="newsletter-input flex-1 min-w-0 rounded-lg px-3 py-2 text-sm
               bg-[var(--btn-regular-bg)] text-90
               border border-transparent
               placeholder:text-30
               focus:outline-none focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent
               transition"
      />
      <button
        type="submit"
        id="newsletter-submit"
        class="newsletter-submit btn-regular rounded-lg px-4 py-2 text-sm font-semibold
               whitespace-nowrap active:scale-95 transition
               hover:bg-[var(--primary)] hover:text-white"
      >
        <span id="newsletter-btn-text">{buttonLabel}</span>
        <span id="newsletter-btn-spinner" class="hidden">
          <svg class="animate-spin h-4 w-4 inline-block" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
          </svg>
        </span>
      </button>
    </div>

    <!-- Privacy notice -->
    <p id="newsletter-hint" class="text-[11px] text-30 mt-2 leading-snug">
      By subscribing, you agree to receive email updates from TechAnV Consulting.
      Your email is never shared or sold. <a href="/privacy/" class="underline hover:text-[var(--primary)]">Privacy Policy</a>.
    </p>
  </form>

  <!-- Success state -->
  <div id="newsletter-success" class="hidden">
    <div class="flex items-center gap-2 text-sm text-[var(--primary)] font-semibold">
      <Icon name="material-symbols:check-circle-outline-rounded" class="text-xl" />
      <span>You're almost there!</span>
    </div>
    <p class="text-xs text-50 mt-1 leading-relaxed">
      Check your inbox and click the confirmation link to complete your subscription.
    </p>
  </div>

  <!-- Error state -->
  <div id="newsletter-error" class="hidden mt-2">
    <div class="flex items-start gap-2 text-sm text-[oklch(0.55_0.20_25)] dark:text-[oklch(0.70_0.18_25)]">
      <Icon name="material-symbols:error-outline-rounded" class="text-lg shrink-0 mt-0.5" />
      <span id="newsletter-error-text">Something went wrong. Please try again.</span>
    </div>
  </div>
</div>

<script>
let _newsletterAbort: AbortController | null = null;

function initNewsletter() {
  // Abort previous listeners to prevent duplicate submissions
  _newsletterAbort?.abort();
  _newsletterAbort = new AbortController();
  const signal = _newsletterAbort.signal;

  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const widget = document.getElementById("newsletter-widget");
  const successEl = document.getElementById("newsletter-success");
  const errorEl = document.getElementById("newsletter-error");
  const errorText = document.getElementById("newsletter-error-text");
  const btnText = document.getElementById("newsletter-btn-text");
  const btnSpinner = document.getElementById("newsletter-btn-spinner");
  const submitBtn = document.getElementById("newsletter-submit") as HTMLButtonElement | null;
  const emailInput = document.getElementById("newsletter-email") as HTMLInputElement | null;

  if (!form || !widget || !successEl || !errorEl || !errorText || !btnText || !btnSpinner || !submitBtn || !emailInput) return;

  const endpoint = widget.dataset.endpoint || "/api/subscribe";

  function setLoading(loading: boolean) {
    submitBtn!.disabled = loading;
    btnText!.classList.toggle("hidden", loading);
    btnSpinner!.classList.toggle("hidden", !loading);
    if (loading) emailInput!.setAttribute("aria-busy", "true");
    else emailInput!.removeAttribute("aria-busy");
  }

  function showError(message: string) {
    errorText!.textContent = message;
    errorEl!.classList.remove("hidden");
    successEl!.classList.add("hidden");
    emailInput!.setAttribute("aria-invalid", "true");
    emailInput!.focus();
  }

  function showSuccess(message?: string) {
    if (message) {
      const successText = successEl!.querySelector('span');
      if (successText) successText.textContent = message;
    }
    successEl!.classList.remove("hidden");
    errorEl!.classList.add("hidden");
    form!.classList.add("hidden");
    emailInput!.removeAttribute("aria-invalid");
  }

  function hideError() {
    errorEl!.classList.add("hidden");
    emailInput!.removeAttribute("aria-invalid");
  }

  emailInput!.addEventListener("input", hideError, { signal });

  function isValidEmail(email: string): boolean {
    const re = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
    return re.test(email.trim());
  }

  form!.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    const email = emailInput!.value.trim();
    if (!email) { showError("Please enter your email address."); return; }
    if (!isValidEmail(email)) { showError("Please enter a valid email address."); return; }

    setLoading(true);
    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, ref: window.location.pathname }),
      });
      const data = await response.json();
      if (data.ok) showSuccess(data.message);
      else showError(data.error || "Something went wrong. Please try again.");
    } catch {
      showError("Network error. Please check your connection.");
    } finally {
      setLoading(false);
    }
  }, { signal });
}

initNewsletter();

// Use only swup hooks (not both hooks AND the custom event) to avoid duplicate calls
if (window.swup) {
  (window as any).swup.hooks.on("content:replace", initNewsletter);
} else {
  document.addEventListener("swup:enable", () => {
    (window as any).swup.hooks.on("content:replace", initNewsletter);
  }, { once: true });
}
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .newsletter-form,
  #newsletter-success,
  #newsletter-error {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>
