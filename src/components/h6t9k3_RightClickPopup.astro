---
// Right Click Protection Popup Component
// Filename: h6t9k3_RightClickPopup.astro
---

<!-- Right Click Protection Popup -->
<div id="rightClickPopup" class="right-click-popup hidden">
  <div class="right-click-content">
    <div class="popup-header">
      <div class="popup-icon">😈</div>
      <h3>Nice Try, Genius!</h3>
    </div>
    <div class="popup-body">
      <p>Think you can steal my code? LOL!</p>
      <p class="popup-subtext">Here's a better idea...</p>
    </div>
    <div class="popup-footer">
      <a
        href="https://www.youtube.com/watch?v=dQw4w9WgXcQ&autoplay=1"
        target="_blank"
        rel="noopener noreferrer"
        class="right-click-link"
        onclick="startRickRoll(event)"
      >
        <span class="link-icon">🎯</span>
        "View Source Code"
        <span class="link-emoji">😏</span>
      </a>
    </div>
  </div>
</div>

<style>
  @import url("/src/styles/q9n5d8_popup.css");
  @import url("/src/styles/r4m7b1_notifications.css");
</style>
