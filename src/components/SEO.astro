---
import { SITE, SOCIALS } from "@config";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  article?: boolean;
}

const {
  title = SITE.title,
  description = SITE.desc,
  ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  tags = [],
  article = false,
} = Astro.props;

const authorName = "Anubhav Gain";
const socialImageURL = ogImage
  ? new URL(ogImage, Astro.url.origin).href
  : new URL(SITE.ogImage, Astro.url.origin).href;

// Enhanced title for better SEO
const enhancedTitle =
  title === SITE.title
    ? `${title} - ${authorName}`
    : `${title} | ${authorName} - ${SITE.title}`;
const enhancedDescription = `${description} Learn more from ${authorName}, a ${SITE.author} specializing in DevSecOps, cybersecurity, and cloud technologies.`;

// Schema.org structured data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${Astro.site}#person`,
  name: authorName,
  givenName: "Anubhav",
  familyName: "Gain",
  alternateName: ["Anubhav Gain", "mranv"],
  description:
    "DevSecOps Engineer, Cybersecurity Expert, and Technical Writer specializing in cloud security, containerization, and security automation.",
  url: Astro.site,
  image: socialImageURL,
  sameAs: [
    SITE.socialLinks.find(link => link.name === "Github")?.href,
    SITE.socialLinks.find(link => link.name === "LinkedIn")?.href,
    SITE.socialLinks
      .find(link => link.name === "Mail")
      ?.href?.replace("mailto:", ""),
  ].filter(Boolean),
  jobTitle: "DevSecOps Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Tech Industry",
  },
  knowsAbout: [
    "DevSecOps",
    "Cybersecurity",
    "Cloud Security",
    "Kubernetes",
    "Docker",
    "Security Automation",
    "Penetration Testing",
    "Infrastructure as Code",
    "CI/CD Security",
    "SIEM",
    "Threat Detection",
  ],
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "Technology Institute",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${Astro.site}#website`,
  url: Astro.site,
  name: `${authorName} - ${SITE.title}`,
  description: SITE.desc,
  publisher: {
    "@id": `${Astro.site}#person`,
  },
  author: {
    "@id": `${Astro.site}#person`,
  },
  inLanguage: "en-US",
};

const articleSchema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "@id": `${canonicalURL}#article`,
      isPartOf: {
        "@id": `${Astro.site}#website`,
      },
      author: {
        "@id": `${Astro.site}#person`,
      },
      headline: title,
      datePublished: pubDatetime?.toISOString(),
      dateModified: modDatetime?.toISOString() || pubDatetime?.toISOString(),
      description: description,
      image: socialImageURL,
      url: canonicalURL,
      inLanguage: "en-US",
      keywords: tags.join(", "),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL,
      },
      publisher: {
        "@type": "Person",
        "@id": `${Astro.site}#person`,
      },
    }
  : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: `${authorName} - Home`,
      item: Astro.site,
    },
    ...(article
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: "Blog Posts",
            item: `${Astro.site}posts/`,
          },
          {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: canonicalURL,
          },
        ]
      : []),
  ],
};

const allSchemas = [
  personSchema,
  websiteSchema,
  ...(articleSchema ? [articleSchema] : []),
  breadcrumbSchema,
];
---

<!-- Primary Meta Tags -->
<title>{enhancedTitle}</title>
<meta name="title" content={enhancedTitle} />
<meta name="description" content={enhancedDescription} />
<meta name="author" content={authorName} />
<link rel="canonical" href={canonicalURL} />

<!-- Additional Meta Tags for SEO -->
<meta
  name="keywords"
  content={`${authorName}, Anubhav Gain, mranv, DevSecOps, ${tags.join(", ")}, cybersecurity, cloud security, technical blog`}
/>
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta name="language" content="English" />
<meta name="revisit-after" content="7 days" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={enhancedTitle} />
<meta property="og:description" content={enhancedDescription} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} by ${authorName}`} />
<meta property="og:site_name" content={`${authorName} - ${SITE.title}`} />
<meta property="og:locale" content="en_US" />

{
  article && (
    <>
      <meta property="article:author" content={authorName} />
      <meta
        property="article:published_time"
        content={pubDatetime?.toISOString()}
      />
      {modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )}
      {tags.map(tag => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={enhancedTitle} />
<meta property="twitter:description" content={enhancedDescription} />
<meta property="twitter:image" content={socialImageURL} />
<meta property="twitter:image:alt" content={`${title} by ${authorName}`} />
{
  SITE.socialLinks.find(link => link.name === "Twitter") && (
    <>
      <meta
        property="twitter:site"
        content={SITE.socialLinks
          .find(link => link.name === "Twitter")
          ?.href.split("/")
          .pop()}
      />
      <meta
        property="twitter:creator"
        content={SITE.socialLinks
          .find(link => link.name === "Twitter")
          ?.href.split("/")
          .pop()}
      />
    </>
  )
}

<!-- Additional SEO Meta Tags -->
<meta name="apple-mobile-web-app-title" content={`${authorName}`} />
<meta name="application-name" content={`${authorName} Blog`} />
<meta name="msapplication-tooltip" content={enhancedDescription} />
<meta name="topic" content="Technology, DevSecOps, Cybersecurity" />
<meta name="summary" content={enhancedDescription} />
<meta name="classification" content="Technology Blog" />
<meta name="subject" content="DevSecOps, Cybersecurity, Cloud Security" />
<meta name="copyright" content={authorName} />
<meta name="designer" content={authorName} />
<meta name="owner" content={authorName} />
<meta name="directory" content="submission" />
<meta name="pagename" content={title} />
<meta name="coverage" content="Worldwide" />

<!-- Geographic Meta Tags -->
<meta name="geo.region" content="IN" />
<meta name="geo.placename" content="India" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${authorName} - RSS Feed`}
  href="/rss.xml"
/>
