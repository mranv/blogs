---
import BreadcrumbNav from "./BreadcrumbNav.tsx";

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

// Build breadcrumb items for the new component
const breadcrumbItems = [];

if (breadcrumbList.length > 0) {
  // Handle posts with pagination
  if (breadcrumbList[0] === "posts") {
    if (breadcrumbList.length === 1) {
      breadcrumbItems.push({ label: "Posts", active: true });
    } else if (!isNaN(Number(breadcrumbList[1]))) {
      breadcrumbItems.push(
        { label: "Posts", href: "/posts/" },
        { label: `Page ${breadcrumbList[1]}`, active: true }
      );
    } else {
      breadcrumbItems.push(
        { label: "Posts", href: "/posts/" },
        { label: decodeURIComponent(breadcrumbList[1]), active: true }
      );
    }
  }
  // Handle tags with pagination
  else if (breadcrumbList[0] === "tags") {
    if (breadcrumbList.length === 1) {
      breadcrumbItems.push({ label: "Tags", active: true });
    } else if (breadcrumbList.length === 2) {
      breadcrumbItems.push(
        { label: "Tags", href: "/tags/" },
        { label: decodeURIComponent(breadcrumbList[1]), active: true }
      );
    } else if (!isNaN(Number(breadcrumbList[2]))) {
      breadcrumbItems.push(
        { label: "Tags", href: "/tags/" },
        {
          label: decodeURIComponent(breadcrumbList[1]),
          href: `/tags/${breadcrumbList[1]}/`,
        },
        { label: `Page ${breadcrumbList[2]}`, active: true }
      );
    }
  }
  // Handle other pages
  else {
    breadcrumbList.forEach((crumb, index) => {
      const isLast = index === breadcrumbList.length - 1;
      const href = isLast
        ? undefined
        : `/${breadcrumbList.slice(0, index + 1).join("/")}/`;
      breadcrumbItems.push({
        label: decodeURIComponent(crumb),
        href,
        active: isLast,
      });
    });
  }
}
---

{
  breadcrumbItems.length > 0 && (
    <div class="breadcrumb-wrapper">
      <BreadcrumbNav client:load items={breadcrumbItems} />
    </div>
  )
}

<style>
  .breadcrumb-wrapper {
    @apply mx-auto mb-1 mt-8 w-full max-w-3xl px-4;
  }
</style>
