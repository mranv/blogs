/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 0.75rem
  --content-delay 150ms
  --font-sans "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'"
  --font-mono "'Maple Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
  --font-serif "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif"
  /* heading/UI font = Maple Mono (crow vibe); body prose keeps --font-sans */
  --font-heading "'Maple Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"

/* An util to define variables that vary with light and dark mode.
   Each value is a [light, dark] pair. Light = Rosé-Pine-Dawn-on-warm-cream,
   dark = crow.rip warm-plum. */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  /* ---- Primary accent (amber/gold glow signature) ---- */
  --primary: #d97a1f #ea9d34
  --title-active: #d97a1f #ea9d34

  /* ---- Surfaces ---- */
  --page-bg: #faf4ed #362b31           /* RP-Dawn cream / crow warm plum */
  --card-bg: #fffaf3 #3d3239           /* floating card, slightly lifted */
  --card-border: #e3dad0 #4a3e44
  --deep-text: #4a3f38 #fdfbd4         /* body text color */

  /* ---- Button content + regular button surfaces ---- */
  --btn-content: #5c5248 #fdfbd4

  --btn-regular-bg: #efe6da #2C2328
  --btn-regular-bg-hover: #e6dacb #4a3e44
  --btn-regular-bg-active: #dccfbd #564650

  --btn-plain-bg-hover: #efe6da #4a3e44
  --btn-plain-bg-active: #e6dacb #564650

  --btn-card-bg-hover: #efe6da #4a3e44
  --btn-card-bg-active: #e6dacb #564650

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  /* ---- Dividers / meta ---- */
  --line-divider: #d8cfc2 #4a3e44
  --line-color: #d8cfc2 #4a3e44
  --meta-divider: #c9bfb0 #564650

  /* ---- Inline code + selection ---- */
  --inline-code-bg: #efe6da #2C2328
  --inline-code-color: #b65a1e #ea9d34
  --selection-bg: #f0d9b0 #564650
  --codeblock-selection: #dccfbd #564650

  /* ---- Code block surfaces ---- */
  --codeblock-bg: #f0ebe4 #241c20
  --codeblock-topbar-bg: #e8e2da #2C2328
  --license-block-bg: black(0.03) #241c20

  /* ---- Links ---- */
  --link-underline: #c9bfb0 #564650
  --link-hover: #d97a1f #ea9d34
  --link-active: #b65a1e #f0b050

  /* ---- Floating glass panels ---- */
  --float-panel-bg: rgba(255,250,243,0.82) rgba(28,20,24,0.78)

  /* ---- Scrollbars ---- */
  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  /* ---- Admonitions (crow-tinted) ---- */
  --admonitions-color-tip: #467a5e #37d99e
  --admonitions-color-note: #3b6ea5 #9ccfd8
  --admonitions-color-important: #7a5a8c #c4a7e7
  --admonitions-color-warning: #b88a2e #ea9d34
  --admonitions-color-caution: #b04a3a #fd5e3a

  /* ---- TOC ---- */
  --toc-badge-bg: #efe6da #2C2328
  --toc-btn-hover: #e6dacb #4a3e44
  --toc-btn-active: #e6dacb #4a3e44
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #d97a1f #ea9d34

  /* ---- NEON GLOW TOKENS (new) ---- */
  --neon-amber: #d97a1f #ea9d34
  --neon-cyan: #3b8ea5 #9ccfd8
  --neon-purple: #907aa9 #c4a7e7
  --neon-pink: #d685af #ebbcba
  --neon-orange: #e8843b #ffb86c
  --glow-color: var(--neon-amber)

  /* ---- crow-compatible color aliases (used by glow.css + CRT toggle) ---- */
  --color-bg-primary: #faf4ed #362b31
  --color-bg-secondary: #fffaf3 #3d3239
  --color-bg-muted: #e3dad0 #4a3e44
  --color-text-primary: #4a3f38 #fdfbd4
  --color-text-muted: #6b5f54 #beae94
  --color-red: #c85a50 #fd5e3a
  --color-yellow: #b88a2e #ea9d34
  --color-green: #467a5e #37d99e
  --color-blue: #3b6ea5 #3e8fb0
  --color-purple: #907aa9 #c4a7e7

  /* ---- GLASS (frosted panels) ---- */
  --glass-bg: rgba(255,250,243,0.80) rgba(28,20,24,0.72)
  --glass-border: rgba(74,62,68,0.14) rgba(253,251,212,0.12)

  /* ---- CRT power-on flash color ---- */
  --crt-flash-bg: #fffaf3 #fdfbd4
})
