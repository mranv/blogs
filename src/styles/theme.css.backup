/* ===== CENTRALIZED THEME COLORS ===== */
/* Based on theme.json - Claude Theme from tweakcn.com */
/* Updated to ensure proper alignment with markdown content and blog posts */

:root,
html[data-theme="light"] {
    /* OKLCH Color Variables from theme.json */
    --background: oklch(0.9818 0.0054 95.0986);
    --foreground: oklch(0.3438 0.0269 95.7226);
    --card: oklch(0.9818 0.0054 95.0986);
    --card-foreground: oklch(0.1908 0.0020 106.5859);
    --popover: oklch(1.0000 0 0);
    --popover-foreground: oklch(0.2671 0.0196 98.9390);
    --primary: oklch(0.6171 0.1375 39.0427);
    --primary-foreground: oklch(1.0000 0 0);
    --secondary: oklch(0.9245 0.0138 92.9892);
    --secondary-foreground: oklch(0.4334 0.0177 98.6048);
    --muted: oklch(0.9341 0.0153 90.2390);
    --muted-foreground: oklch(0.6059 0.0075 97.4233);
    --accent: oklch(0.9245 0.0138 92.9892);
    --accent-foreground: oklch(0.2671 0.0196 98.9390);
    --destructive: oklch(0.1908 0.0020 106.5859);
    --destructive-foreground: oklch(1.0000 0 0);
    --border: oklch(0.8847 0.0069 97.3627);
    --input: oklch(0.7621 0.0156 98.3528);
    --ring: oklch(0.6171 0.1375 39.0427);
    
    /* Sidebar specific colors */
    --sidebar: oklch(0.9663 0.0080 98.8792);
    --sidebar-foreground: oklch(0.3590 0.0051 106.6524);
    --sidebar-primary: oklch(0.6171 0.1375 39.0427);
    --sidebar-primary-foreground: oklch(0.9881 0 0);
    --sidebar-accent: oklch(0.9245 0.0138 92.9892);
    --sidebar-accent-foreground: oklch(0.3250 0 0);
    --sidebar-border: oklch(0.9401 0 0);
    --sidebar-ring: oklch(0.7731 0 0);
    
    /* Chart colors for data visualization */
    --chart-1: oklch(0.5583 0.1276 42.9956);
    --chart-2: oklch(0.6898 0.1581 290.4107);
    --chart-3: oklch(0.8816 0.0276 93.1280);
    --chart-4: oklch(0.8822 0.0403 298.1792);
    --chart-5: oklch(0.5608 0.1348 42.0584);
    
    /* Typography */
    --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
    --font-serif: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    
    /* Border radius */
    --radius: 0.5rem;
    
    /* Shadows from theme.json */
    --shadow-xs: 0 1px 3px 0px hsl(0 0% 0% / 0.05);
    --shadow-sm: 0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10);
    --shadow-md: 0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 2px 4px -1px hsl(0 0% 0% / 0.10);
    --shadow-lg: 0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 4px 6px -1px hsl(0 0% 0% / 0.10);
    --shadow-xl: 0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 8px 10px -1px hsl(0 0% 0% / 0.10);
    --shadow-2xl: 0 1px 3px 0px hsl(0 0% 0% / 0.25);
    
    /* Legacy color variables for compatibility */
    --color-fill: 250, 250, 252;
    --color-text-base: 17, 24, 39;
    --color-accent: 98, 114, 164;
    --color-card: 255, 255, 255;
    --color-card-muted: 249, 250, 251;
    --color-border: 229, 231, 235;
    --color-gradient-start: 98, 114, 164;
    --color-gradient-end: 71, 85, 105;
    --color-secondary: 75, 85, 99;
    --color-success: 16, 185, 129;
    --color-warning: 251, 146, 60;
    --color-glow: 98, 114, 164;
    --color-shadow: 0, 0, 0;
  }

  html[data-theme="dark"] {
    /* Dark mode OKLCH Color Variables */
    --background: oklch(0.2679 0.0036 106.6427);
    --foreground: oklch(0.8074 0.0142 93.0137);
    --card: oklch(0.2679 0.0036 106.6427);
    --card-foreground: oklch(0.9818 0.0054 95.0986);
    --popover: oklch(0.3085 0.0035 106.6039);
    --popover-foreground: oklch(0.9211 0.0040 106.4781);
    --primary: oklch(0.6724 0.1308 38.7559);
    --primary-foreground: oklch(1.0000 0 0);
    --secondary: oklch(0.9818 0.0054 95.0986);
    --secondary-foreground: oklch(0.3085 0.0035 106.6039);
    --muted: oklch(0.2213 0.0038 106.7070);
    --muted-foreground: oklch(0.7713 0.0169 99.0657);
    --accent: oklch(0.2130 0.0078 95.4245);
    --accent-foreground: oklch(0.9663 0.0080 98.8792);
    --destructive: oklch(0.6368 0.2078 25.3313);
    --destructive-foreground: oklch(1.0000 0 0);
    --border: oklch(0.3618 0.0101 106.8928);
    --input: oklch(0.4336 0.0113 100.2195);
    --ring: oklch(0.6724 0.1308 38.7559);
    
    /* Dark mode sidebar colors */
    --sidebar: oklch(0.2357 0.0024 67.7077);
    --sidebar-foreground: oklch(0.8074 0.0142 93.0137);
    --sidebar-primary: oklch(0.3250 0 0);
    --sidebar-primary-foreground: oklch(0.9881 0 0);
    --sidebar-accent: oklch(0.1680 0.0020 106.6177);
    --sidebar-accent-foreground: oklch(0.8074 0.0142 93.0137);
    --sidebar-border: oklch(0.9401 0 0);
    --sidebar-ring: oklch(0.7731 0 0);
    
    /* Dark mode chart colors */
    --chart-1: oklch(0.5583 0.1276 42.9956);
    --chart-2: oklch(0.6898 0.1581 290.4107);
    --chart-3: oklch(0.2130 0.0078 95.4245);
    --chart-4: oklch(0.3074 0.0516 289.3230);
    --chart-5: oklch(0.5608 0.1348 42.0584);
  }

/* ===== THEME UTILITY CLASSES ===== */

/* Background utilities */
.bg-theme-background { background-color: hsl(var(--background)); }
.bg-theme-card { background-color: hsl(var(--card)); }
.bg-theme-popover { background-color: hsl(var(--popover)); }
.bg-theme-primary { background-color: hsl(var(--primary)); }
.bg-theme-secondary { background-color: hsl(var(--secondary)); }
.bg-theme-muted { background-color: hsl(var(--muted)); }
.bg-theme-accent { background-color: hsl(var(--accent)); }
.bg-theme-destructive { background-color: hsl(var(--destructive)); }
.bg-theme-sidebar { background-color: hsl(var(--sidebar)); }

/* Input utilities */
.bg-theme-input { background-color: hsl(var(--input)); }

/* Ring utilities */
.ring-theme-ring { --tw-ring-color: hsl(var(--ring)); }

/* Text utilities */
.text-theme-foreground { color: hsl(var(--foreground)); }
.text-theme-card-foreground { color: hsl(var(--card-foreground)); }
.text-theme-popover-foreground { color: hsl(var(--popover-foreground)); }
.text-theme-primary { color: hsl(var(--primary)); }
.text-theme-primary-foreground { color: hsl(var(--primary-foreground)); }
.text-theme-secondary { color: hsl(var(--secondary)); }
.text-theme-secondary-foreground { color: hsl(var(--secondary-foreground)); }
.text-theme-muted { color: hsl(var(--muted)); }
.text-theme-muted-foreground { color: hsl(var(--muted-foreground)); }
.text-theme-accent { color: hsl(var(--accent)); }
.text-theme-accent-foreground { color: hsl(var(--accent-foreground)); }
.text-theme-destructive { color: hsl(var(--destructive)); }
.text-theme-destructive-foreground { color: hsl(var(--destructive-foreground)); }
.text-theme-sidebar { color: hsl(var(--sidebar)); }
.text-theme-sidebar-foreground { color: hsl(var(--sidebar-foreground)); }

/* Border utilities */
.border-theme-border { border-color: hsl(var(--border)); }
.border-theme-input { border-color: hsl(var(--input)); }
.border-theme-ring { border-color: hsl(var(--ring)); }
.border-theme-sidebar-border { border-color: hsl(var(--sidebar-border)); }

/* Ring utilities */
.ring-theme-ring { --tw-ring-color: hsl(var(--ring)); }

/* Chart color utilities */
.chart-color-1 { color: hsl(var(--chart-1)); }
.chart-color-2 { color: hsl(var(--chart-2)); }
.chart-color-3 { color: hsl(var(--chart-3)); }
.chart-color-4 { color: hsl(var(--chart-4)); }
.chart-color-5 { color: hsl(var(--chart-5)); }

.chart-bg-1 { background-color: hsl(var(--chart-1)); }
.chart-bg-2 { background-color: hsl(var(--chart-2)); }
.chart-bg-3 { background-color: hsl(var(--chart-3)); }
.chart-bg-4 { background-color: hsl(var(--chart-4)); }
.chart-bg-5 { background-color: hsl(var(--chart-5)); }

/* Animation utilities - defined here to ensure availability */

.animate-fade-in-up {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.8s ease-out forwards;
}

.animate-delay-800 {
  animation-delay: 0.8s;
}

/* ===== ABOUT PAGE STYLES REMOVED - NOW USING THEME UTILITY CLASSES ===== */

/* ===== THEME COMPONENT STYLES ===== */

/* Chatbot Theme Integration */
.chatbot-container {
  @apply fixed bottom-6 right-6 z-50;
}

.chatbot-toggle {
  @apply bg-primary hover:bg-primary/90 text-primary-foreground rounded-full p-4 shadow-lg;
  @apply transition-all duration-300 hover:scale-105 active:scale-95;
  @apply focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary;
  box-shadow: 0 10px 25px hsl(var(--primary) / 0.3);
}

.chatbot-toggle:hover {
  box-shadow: 0 15px 35px hsl(var(--primary) / 0.4);
}

.chatbot-window {
  @apply absolute bottom-16 right-0 w-96 h-[32rem] bg-card rounded-2xl border border-border;
  @apply flex flex-col overflow-hidden shadow-2xl backdrop-blur-md;
  box-shadow: 0 25px 50px -12px hsl(var(--shadow) / 0.25);
}

.chatbot-header {
  @apply bg-primary text-primary-foreground p-4 flex items-center gap-3;
}

.chatbot-messages {
  @apply flex-1 overflow-y-auto p-4 space-y-4;
}

.chatbot-message {
  @apply max-w-[80%] rounded-2xl p-3 transition-all duration-200;
}

.chatbot-message--bot {
  @apply bg-muted text-foreground;
}

.chatbot-message--user {
  @apply bg-primary text-primary-foreground;
}

.chatbot-input-container {
  @apply p-4 border-t border-border;
}

.chatbot-input {
  @apply flex-1 px-4 py-2 border border-border rounded-full;
  @apply focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent;
  @apply bg-background text-foreground placeholder:text-muted-foreground;
  @apply transition-all duration-200;
}

.chatbot-send-button {
  @apply bg-primary hover:bg-primary/90 text-primary-foreground rounded-full p-2;
  @apply transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary;
}

.chatbot-send-button:disabled {
  @apply bg-muted cursor-not-allowed;
}

/* Dark mode adjustments */
html[data-theme="dark"] .chatbot-window {
  box-shadow: 0 25px 50px -12px hsl(var(--shadow) / 0.5);
}

/* Button variants using theme colors */
.btn-theme-primary {
  background-color: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s ease-in-out;
}

.btn-theme-primary:hover {
  background-color: hsl(var(--primary) / 0.9);
}

.btn-theme-secondary {
  background-color: hsl(var(--secondary));
  color: hsl(var(--secondary-foreground));
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s ease-in-out;
}

.btn-theme-secondary:hover {
  background-color: hsl(var(--secondary) / 0.8);
}

.btn-theme-destructive {
  background-color: hsl(var(--destructive));
  color: hsl(var(--destructive-foreground));
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s ease-in-out;
}

.btn-theme-destructive:hover {
  background-color: hsl(var(--destructive) / 0.9);
}

.btn-theme-outline {
  border: 1px solid hsl(var(--input));
  background-color: hsl(var(--background));
  color: hsl(var(--foreground));
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s ease-in-out;
}

.btn-theme-outline:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--accent-foreground));
}

.btn-theme-ghost {
  background-color: transparent;
  color: hsl(var(--foreground));
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s ease-in-out;
}

.btn-theme-ghost:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--accent-foreground));
}

/* Card styles using theme colors */
.card-theme {
  border-radius: 0.5rem;
  border: 1px solid hsl(var(--border));
  background-color: hsl(var(--card));
  color: hsl(var(--card-foreground));
  box-shadow: 0 1px 3px 0px hsl(0 0% 0% / 0.1);
}

/* Input styles using theme colors */
.input-theme {
  display: flex;
  height: 2.5rem;
  width: 100%;
  border-radius: 0.5rem;
  border: 1px solid hsl(var(--input));
  background-color: hsl(var(--background));
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  transition: all 0.2s ease-in-out;
}

.input-theme:focus {
  outline: none;
  border-color: hsl(var(--ring));
  box-shadow: 0 0 0 2px hsl(var(--ring) / 0.2);
}

.input-theme::placeholder {
  color: hsl(var(--muted-foreground));
}

/* Badge styles using theme colors */
.badge-theme-default {
  border: 1px solid transparent;
  background-color: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
  border-radius: 9999px;
  padding: 0.25rem 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  transition: all 0.2s ease-in-out;
}

.badge-theme-default:hover {
  background-color: hsl(var(--primary) / 0.8);
}

.badge-theme-secondary {
  border: 1px solid transparent;
  background-color: hsl(var(--secondary));
  color: hsl(var(--secondary-foreground));
  border-radius: 9999px;
  padding: 0.25rem 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  transition: all 0.2s ease-in-out;
}

.badge-theme-secondary:hover {
  background-color: hsl(var(--secondary) / 0.8);
}

.badge-theme-destructive {
  border: 1px solid transparent;
  background-color: hsl(var(--destructive));
  color: hsl(var(--destructive-foreground));
  border-radius: 9999px;
  padding: 0.25rem 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  transition: all 0.2s ease-in-out;
}

.badge-theme-destructive:hover {
  background-color: hsl(var(--destructive) / 0.8);
}

.badge-theme-outline {
  color: hsl(var(--foreground));
}

/* ===== THEME TRANSITIONS ===== */
.theme-transition {
  transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}

/* ===== RESPONSIVE THEME UTILITIES ===== */
@media (max-width: 640px) {
  .theme-mobile {
    --radius: 0.375rem;
  }
}

/* ===== BLOG POST THEME ENHANCEMENTS ===== */
.blog-post-theme {
  --post-max-width: 65ch;
  --post-line-height: 1.75;
  --post-paragraph-spacing: 1.5rem;
  --post-heading-spacing: 2rem;
}

.blog-post-theme .prose {
  max-width: var(--post-max-width);
  line-height: var(--post-line-height);
}

.blog-post-theme .prose p {
  margin-bottom: var(--post-paragraph-spacing);
}

.blog-post-theme .prose h1,
.blog-post-theme .prose h2,
.blog-post-theme .prose h3,
.blog-post-theme .prose h4,
.blog-post-theme .prose h5,
.blog-post-theme .prose h6 {
  margin-top: var(--post-heading-spacing);
  margin-bottom: calc(var(--post-heading-spacing) * 0.5);
}

/* ===== MARKDOWN CONTENT ALIGNMENT ===== */
.markdown-content {
  @apply text-foreground;
  @apply leading-relaxed;
  @apply max-w-none;
}

.markdown-content h1,
.markdown-content h2,
.markdown-content h3,
.markdown-content h4,
.markdown-content h5,
.markdown-content h6 {
  @apply text-foreground font-semibold;
  @apply scroll-mt-20;
  @apply mb-4;
}

.markdown-content h1 {
  @apply text-4xl font-bold mt-12 mb-8;
  letter-spacing: -0.03em;
}

.markdown-content h2 {
  @apply text-3xl font-semibold mt-10 mb-6;
  letter-spacing: -0.02em;
}

.markdown-content h3 {
  @apply text-2xl font-medium mt-8 mb-4;
  letter-spacing: -0.01em;
}

.markdown-content p {
  @apply text-foreground/90 mb-6;
  @apply text-lg leading-relaxed;
}

.markdown-content a {
  @apply text-primary hover:text-primary/80;
  @apply underline underline-offset-2;
  @apply transition-all duration-200;
  text-decoration-color: hsl(var(--primary) / 0.3);
}

.markdown-content a:hover {
  text-decoration-color: hsl(var(--primary) / 0.6);
}

.markdown-content strong {
  @apply text-foreground font-semibold;
}

.markdown-content em {
  @apply text-foreground/80 italic;
}

.markdown-content blockquote {
  @apply border-l-4 border-primary/60 bg-primary/5;
  @apply pl-6 py-4 my-8 rounded-r-lg;
  @apply italic text-foreground/80;
}

.markdown-content code {
  @apply bg-muted text-foreground;
  @apply px-2 py-1 rounded text-sm font-mono;
  @apply border border-border/50;
}

.markdown-content pre {
  @apply bg-card border border-border;
  @apply p-6 rounded-xl shadow-lg;
  @apply overflow-x-auto my-8;
}

.markdown-content pre code {
  @apply bg-transparent border-none p-0;
  @apply text-foreground;
}

.markdown-content ul,
.markdown-content ol {
  @apply text-foreground/90 space-y-2 mb-6;
}

.markdown-content li {
  @apply text-foreground/90;
}

.markdown-content li::marker {
  @apply text-primary;
}

.markdown-content table {
  @apply w-full border-collapse my-8;
  @apply bg-card border border-border rounded-lg overflow-hidden;
}

.markdown-content th {
  @apply bg-muted text-foreground font-semibold;
  @apply p-3 text-left border-b border-border;
}

.markdown-content td {
  @apply p-3 border-b border-border/50;
  @apply text-foreground/90;
}

.markdown-content img {
  @apply rounded-xl shadow-lg;
  @apply mx-auto my-8;
  @apply border border-border/50;
}

.markdown-content hr {
  @apply border-border/50 my-12;
}

/* ===== ACCESSIBILITY ENHANCEMENTS ===== */
@media (prefers-reduced-motion: reduce) {
  .theme-transition {
    transition: none;
  }
}

/* ===== AUTHENTICATION COMPONENT STYLES ===== */
/* Login/Signup page specific styles using Claude Theme colors */
/* Theme toggle button */
.auth-theme-toggle {
  position: absolute;
  top: 2rem;
  right: 2rem;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius);
  background: linear-gradient(
    135deg,
    hsl(var(--card)) 0%,
    hsl(var(--card) / 0.95) 100%
  );
  border: 1px solid hsl(var(--border) / 0.3);
  color: hsl(var(--primary));
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: var(--shadow-sm);
}

.auth-theme-toggle:hover {
  transform: scale(1.05);
  background: linear-gradient(
    135deg,
    hsl(var(--primary) / 0.1) 0%,
    hsl(var(--primary) / 0.15) 100%
  );
  border-color: hsl(var(--primary) / 0.3);
  box-shadow: 
    0 0 0 3px hsl(var(--primary) / 0.1),
    var(--shadow-md);
}

/* Dark mode specific styles */
html[data-theme="dark"] .auth-theme-toggle {
  background: linear-gradient(
    135deg,
    hsl(var(--card)) 0%,
    hsl(var(--card) / 0.85) 100%
  );
  border-color: hsl(var(--border) / 0.5);
}

html[data-theme="dark"] .auth-theme-toggle:hover {
  background: linear-gradient(
    135deg,
    hsl(var(--primary) / 0.2) 0%,
    hsl(var(--primary) / 0.25) 100%
  );
  border-color: hsl(var(--primary) / 0.5);
}

.auth-container {
  @apply relative flex min-h-screen w-full items-center justify-center overflow-hidden p-4;
  background: linear-gradient(
    135deg,
    hsl(var(--background)) 0%,
    hsl(var(--background)) 50%,
    hsl(var(--muted) / 0.3) 100%
  );
  position: relative;
}

/* Dark mode container */
html[data-theme="dark"] .auth-container {
  background: linear-gradient(
    135deg,
    hsl(var(--background)) 0%,
    hsl(var(--background) / 0.95) 50%,
    hsl(var(--primary) / 0.05) 100%
  );
}

.auth-background-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.6;
  z-index: 1;
  background: 
    radial-gradient(
      circle at 20% 30%,
      hsl(var(--chart-1) / 0.15) 0%,
      transparent 40%
    ),
    radial-gradient(
      circle at 80% 70%,
      hsl(var(--chart-2) / 0.15) 0%,
      transparent 40%
    ),
    radial-gradient(
      circle at 50% 50%,
      hsl(var(--primary) / 0.08) 0%,
      transparent 60%
    );
  animation: gradientShift 20s ease infinite;
}

@keyframes gradientShift {
  0%, 100% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.1) rotate(180deg); }
}

html[data-theme="dark"] .auth-background-gradient {
  opacity: 0.4;
  background: 
    radial-gradient(
      circle at 20% 30%,
      hsl(var(--chart-1) / 0.2) 0%,
      transparent 40%
    ),
    radial-gradient(
      circle at 80% 70%,
      hsl(var(--chart-2) / 0.2) 0%,
      transparent 40%
    ),
    radial-gradient(
      circle at 50% 50%,
      hsl(var(--primary) / 0.15) 0%,
      transparent 60%
    );
}

.auth-card {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 72rem;
  margin: 0 auto;
  background: linear-gradient(
    135deg,
    hsl(var(--card) / 0.98) 0%,
    hsl(var(--card) / 0.95) 100%
  );
  backdrop-filter: blur(20px) saturate(150%);
  overflow: hidden;
  border-radius: 1.5rem;
  box-shadow: 
    0 0 0 1px hsl(var(--border) / 0.1),
    0 20px 25px -5px hsl(var(--foreground) / 0.1),
    0 10px 10px -5px hsl(var(--foreground) / 0.04),
    inset 0 1px 0 0 hsl(var(--primary) / 0.1);
  border: 1px solid hsl(var(--border) / 0.2);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.auth-card:hover {
  transform: translateY(-4px);
  box-shadow: 
    0 0 0 1px hsl(var(--primary) / 0.2),
    0 25px 30px -5px hsl(var(--foreground) / 0.15),
    0 15px 15px -5px hsl(var(--foreground) / 0.06),
    inset 0 1px 0 0 hsl(var(--primary) / 0.2);
  border-color: hsl(var(--primary) / 0.3);
}

html[data-theme="dark"] .auth-card {
  background: linear-gradient(
    135deg,
    hsl(var(--card)) 0%,
    hsl(var(--card) / 0.95) 100%
  );
  box-shadow: 
    0 0 0 1px hsl(var(--border) / 0.2),
    0 20px 25px -5px hsl(0 0% 0% / 0.3),
    0 10px 10px -5px hsl(0 0% 0% / 0.2),
    inset 0 1px 0 0 hsl(var(--primary) / 0.2);
}

.auth-card > div {
  position: relative;
  z-index: 1;
}

.auth-brand-side {
  position: relative;
  margin: 1rem;
  border-radius: 1rem;
  padding: 3rem;
  border: 1px solid hsl(var(--border) / 0.15);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 600px;
  background: 
    linear-gradient(
      135deg,
      hsl(var(--primary) / 0.03) 0%,
      transparent 50%
    ),
    linear-gradient(
      225deg,
      hsl(var(--chart-1) / 0.05) 0%,
      transparent 50%
    ),
    linear-gradient(
      315deg,
      hsl(var(--chart-2) / 0.05) 0%,
      transparent 50%
    ),
    hsl(var(--card));
  overflow: hidden;
}

.auth-brand-side::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(
    circle,
    hsl(var(--primary) / 0.1) 0%,
    transparent 70%
  );
  pointer-events: none;
  animation: float 20s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33% { transform: translate(30px, -30px) rotate(120deg); }
  66% { transform: translate(-20px, 20px) rotate(240deg); }
}

html[data-theme="dark"] .auth-brand-side {
  background: 
    linear-gradient(
      135deg,
      hsl(var(--primary) / 0.1) 0%,
      transparent 50%
    ),
    linear-gradient(
      225deg,
      hsl(var(--chart-1) / 0.15) 0%,
      transparent 50%
    ),
    linear-gradient(
      315deg,
      hsl(var(--chart-2) / 0.15) 0%,
      transparent 50%
    ),
    hsl(var(--card));
}

.auth-form-side {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 3rem;
  background-color: hsl(var(--card));
  min-height: 600px;
  overflow: hidden;
}

.auth-input-group {
  position: relative;
  margin-bottom: 1rem;
}

.auth-input {
  display: block;
  width: 100%;
  border-radius: var(--radius);
  padding: 0.75rem 1rem 0.75rem 3rem;
  font-size: 0.875rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background-color: hsl(var(--background));
  border: 1px solid hsl(var(--input));
  color: hsl(var(--foreground));
}

.auth-input:focus {
  outline: none;
  border-color: hsl(var(--ring));
  box-shadow: 0 0 0 2px hsl(var(--ring) / 0.2);
}

.auth-input::placeholder {
  color: hsl(var(--muted-foreground));
}

.auth-input-icon {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding-left: 16px;
  color: hsl(var(--primary) / 0.7);
  pointer-events: none;
  z-index: 5;
  transition: color 0.3s ease;
}

.auth-input:focus ~ .auth-input-icon {
  color: hsl(var(--primary));
  filter: drop-shadow(0 0 8px hsl(var(--primary) / 0.5));
}

.auth-toggle-icon {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding-right: 12px;
  color: hsl(var(--primary) / 0.6);
  transition: color 0.2s ease-in-out;
  z-index: 5;
  cursor: pointer;
}

.auth-toggle-icon:hover {
  color: hsl(var(--primary));
}

.auth-button-primary {
  position: relative;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: linear-gradient(
    135deg,
    hsl(var(--primary)) 0%,
    hsl(var(--primary) / 0.9) 100%
  );
  color: hsl(var(--primary-foreground));
  border: none;
  cursor: pointer;
  z-index: 5;
  overflow: hidden;
  box-shadow: 
    0 4px 14px 0 hsl(var(--primary) / 0.3),
    inset 0 1px 0 0 hsl(var(--primary-foreground) / 0.1);
}

.auth-button-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    hsl(var(--primary-foreground) / 0.2) 50%,
    transparent 100%
  );
  transition: left 0.5s ease;
}

.auth-button-primary:hover::before {
  left: 100%;
}

.auth-button-primary:hover {
  transform: translateY(-2px);
  background: linear-gradient(
    135deg,
    hsl(var(--primary) / 0.95) 0%,
    hsl(var(--primary) / 0.85) 100%
  );
  box-shadow: 
    0 6px 20px 0 hsl(var(--primary) / 0.4),
    inset 0 1px 0 0 hsl(var(--primary-foreground) / 0.2);
}

.auth-button-primary:focus {
  outline: none;
  box-shadow: 0 0 0 2px hsl(var(--ring));
}

.auth-button-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: scale(1);
}

.auth-button-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: 400;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background-color: hsl(var(--background));
  border: 1px solid hsl(var(--input));
  color: hsl(var(--foreground));
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.auth-button-outline:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--accent-foreground));
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* OAuth buttons specific styling */
.auth-oauth-grid {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  margin-top: 1rem;
  min-height: 44px; /* Prevent layout shift */
  align-items: center;
}

.auth-button-oauth {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  padding: 0.625rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 400;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background-color: hsl(var(--background));
  border: 1px solid hsl(var(--input));
  color: hsl(var(--foreground));
  cursor: pointer;
  white-space: nowrap;
  min-width: 120px; /* Fixed minimum width */
  height: 40px; /* Fixed height */
  flex-shrink: 0; /* Prevent shrinking */
}

.auth-button-oauth img,
.auth-button-oauth svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.auth-button-oauth span {
  margin-left: 0.5rem;
  line-height: 1;
}

.auth-button-oauth:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--accent-foreground));
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.auth-checkbox {
  height: 16px;
  width: 16px;
  border-radius: 4px;
  border: 1px solid hsl(var(--input));
  color: hsl(var(--primary));
  cursor: pointer;
  transition: all 0.2s ease;
}

.auth-checkbox:hover {
  border-color: hsl(var(--primary));
}

.auth-checkbox:checked {
  background-color: hsl(var(--primary));
  border-color: hsl(var(--primary));
}

.auth-checkbox:focus {
  border-color: hsl(var(--ring));
  box-shadow: 0 0 0 2px hsl(var(--ring) / 0.2);
}

.auth-divider {
  position: relative;
  text-align: center;
  font-size: 0.75rem;
  color: hsl(var(--muted-foreground));
  margin: 1.5rem 0;
  font-weight: 400;
  min-height: 1.5rem; /* Prevent collapse */
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-divider::before {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  content: '';
  border-top: 1px solid hsl(var(--border));
}

.auth-divider-text {
  position: relative;
  padding: 0 16px;
  background-color: hsl(var(--card));
  z-index: 1;
}

.auth-demo-credentials {
  margin-top: 1.5rem;
  padding: 1rem;
  border-radius: var(--radius);
  border: 1px solid hsl(var(--border) / 0.2);
  background: linear-gradient(
    135deg,
    hsl(var(--chart-3) / 0.1) 0%,
    hsl(var(--chart-4) / 0.05) 100%
  );
  position: relative;
  overflow: hidden;
}

.auth-demo-credentials::before {
  content: '✨';
  position: absolute;
  top: -10px;
  right: -10px;
  font-size: 40px;
  opacity: 0.2;
  transform: rotate(-15deg);
}

html[data-theme="dark"] .auth-demo-credentials {
  background: linear-gradient(
    135deg,
    hsl(var(--chart-3) / 0.2) 0%,
    hsl(var(--chart-4) / 0.1) 100%
  );
  border-color: hsl(var(--border) / 0.3);
}

.auth-message {
  margin-bottom: 1.5rem;
  padding: 1rem;
  border-radius: var(--radius);
  font-size: 0.875rem;
  font-weight: 400;
  border: 1px solid transparent;
  position: relative;
}

.auth-message.success {
  background-color: hsl(142 76% 36% / 0.1);
  border-color: hsl(142 76% 36% / 0.2);
  color: hsl(142 76% 36%);
}

.auth-message.error {
  background-color: hsl(var(--destructive) / 0.1);
  border-color: hsl(var(--destructive) / 0.2);
  color: hsl(var(--destructive));
}

/* Brand name gradient effect */
.auth-brand-name {
  background: linear-gradient(
    135deg,
    hsl(var(--primary)) 0%,
    hsl(var(--chart-1)) 25%,
    hsl(var(--chart-2)) 50%,
    hsl(var(--primary)) 100%
  );
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientMove 3s ease infinite;
}

@keyframes gradientMove {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* Prevent text overlap */
.auth-brand-side h1 {
  word-break: break-words;
  overflow-wrap: break-word;
}

/* Grid layout fixes */
.auth-card .grid {
  display: grid;
  grid-template-columns: 1fr;
  min-height: 700px;
}

@media (min-width: 1024px) {
  .auth-card .grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* Ensure proper spacing between grid items */
.auth-card .grid > div {
  position: relative;
}

/* Fix for feature items */
.feature-item {
  animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  opacity: 0;
  transform: translateY(20px);
  position: relative;
  z-index: 1;
  padding: 1rem;
  border-radius: var(--radius);
  transition: all 0.3s ease;
}

.feature-item:hover {
  background: linear-gradient(
    135deg,
    hsl(var(--primary) / 0.05) 0%,
    hsl(var(--primary) / 0.02) 100%
  );
  transform: translateX(4px);
}

.feature-item:nth-child(1) { 
  animation-delay: 0.1s;
  --feature-color: var(--chart-1);
}
.feature-item:nth-child(2) { 
  animation-delay: 0.2s;
  --feature-color: var(--chart-2);
}
.feature-item:nth-child(3) { 
  animation-delay: 0.3s;
  --feature-color: var(--chart-3);
}
.feature-item:nth-child(4) { 
  animation-delay: 0.4s;
  --feature-color: var(--chart-4);
}

.feature-item svg {
  color: hsl(var(--primary));
}

html[data-theme="dark"] .feature-item:hover {
  background: linear-gradient(
    135deg,
    hsl(var(--primary) / 0.1) 0%,
    hsl(var(--primary) / 0.05) 100%
  );
}

/* Responsive fixes - Consolidated */
@media (max-width: 1024px) {
  .auth-card {
    border-radius: calc(var(--radius) * 3);
    box-shadow: 
      0 0 0 1px hsl(var(--border) / 0.1),
      0 10px 30px -10px hsl(var(--foreground) / 0.1);
  }
  
  .auth-brand-side,
  .auth-form-side {
    min-height: 500px;
    padding: calc(var(--spacing) * 8);
  }
  
  .auth-brand-side h1 {
    font-size: 2.25rem;
  }
  
  .auth-brand-side::before {
    width: 150%;
    height: 150%;
  }
}

@media (max-width: 768px) {
  .auth-container {
    padding: calc(var(--spacing) * 3);
  }
  
  .auth-card {
    border-radius: calc(var(--radius) * 2.5);
    margin: 0 auto;
    max-width: 420px;
  }
  
  .auth-card:hover {
    transform: none;
  }
  
  .auth-brand-side,
  .auth-form-side {
    min-height: auto;
    padding: calc(var(--spacing) * 6);
  }
  
  .auth-brand-side {
    display: none;
  }
  
  .auth-brand-side h1 {
    font-size: 1.75rem;
  }
  
  .auth-input {
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 3) calc(var(--spacing) * 3) calc(var(--spacing) * 10);
    font-size: 0.875rem;
  }
  
  .auth-button-primary,
  .auth-button-outline {
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 3);
    font-size: 0.875rem;
  }
  
  .auth-demo-credentials {
    padding: 12px 16px;
  }
  
  .feature-item {
    margin-bottom: 1rem;
  }
}


/* ===== PRINT STYLES ===== */
@media print {
  .theme-print {
    --background: white;
    --foreground: black;
    --card: white;
    --card-foreground: black;
  }
}

/* ===== HOME PAGE SPECIFIC THEME UTILITIES ===== */

/* Gradient utilities for hero section */
.gradient-text-primary {
  background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)), hsl(var(--primary)));
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.gradient-bg-primary {
  background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
}

.gradient-border-primary {
  border-image: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent))) 1;
}

/* Enhanced card styles for home page */
.card-home {
  @apply rounded-xl border bg-card text-card-foreground shadow-sm;
  @apply transition-all duration-300 hover:shadow-lg hover:-translate-y-1;
  @apply backdrop-blur-sm bg-card/90;
}

.card-home:hover {
  @apply border-primary/30;
}

/* Stats card specific styling */
.stats-card {
  @apply rounded-xl border bg-card text-card-foreground shadow-sm;
  @apply transition-all duration-300 hover:shadow-lg hover:-translate-y-1;
  @apply backdrop-blur-sm bg-card/90 p-4;
}

.stats-card:hover {
  @apply border-primary/30;
}

.stats-number {
  @apply text-2xl font-bold text-primary;
}

/* Technology card enhancements */
.tech-card {
  @apply rounded-xl border bg-card text-card-foreground shadow-sm;
  @apply transition-all duration-300 hover:shadow-lg hover:-translate-y-1;
  @apply backdrop-blur-sm bg-card/90;
}

.tech-card:hover {
  @apply border-primary/30;
}

.tech-card h3 {
  @apply text-xl font-semibold leading-none tracking-tight text-card-foreground;
}

/* Enhanced button styles */
.btn-home-primary {
  @apply inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium;
  @apply transition-all duration-200 focus-visible:outline-none focus-visible:ring-2;
  @apply focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50;
  @apply relative overflow-hidden bg-primary text-primary-foreground shadow-sm;
  @apply hover:bg-primary/90 hover:shadow-md;
  @apply before:absolute before:inset-0 before:bg-gradient-to-r before:from-white/0 before:via-white/20 before:to-white/0;
  @apply before:translate-x-[-200%] hover:before:translate-x-[200%] before:transition-transform before:duration-700;
  @apply h-10 px-5 py-2;
}

/* Newsletter section enhancements */
.newsletter-card {
  @apply rounded-xl border bg-card text-card-foreground shadow-sm;
  @apply transition-all duration-300 hover:shadow-lg backdrop-blur-sm bg-card/90 p-8;
}

.newsletter-input {
  @apply flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm;
  @apply file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground;
  @apply placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2;
  @apply focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50;
  @apply flex-1;
}

/* Tag filter enhancements */
.tag-filter-badge {
  @apply inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold;
  @apply transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2;
  @apply border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80;
  @apply cursor-pointer hover:scale-105 transition-transform duration-200;
}

/* Globe container enhancements */
.globe-container {
  @apply relative mx-auto flex flex-col items-center;
}

.globe-stats {
  @apply mt-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-xs text-muted-foreground;
  @apply animate-fade-in-up animate-delay-800;
}

.globe-stat-item {
  @apply p-2;
}

.globe-stat-icon {
  @apply text-primary font-semibold;
}

/* Section enhancements */
.section-home {
  @apply py-16 bg-background;
}

.section-title {
  @apply text-3xl font-bold text-primary mb-4 animate-fade-in-up;
}

.section-description {
  @apply text-muted-foreground mx-auto animate-fade-in-up;
}

/* Loading state enhancements */
.loading-state {
  @apply fixed inset-0 bg-background flex items-center justify-center z-50;
}

.loading-spinner {
  @apply animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4;
}

.loading-text {
  @apply text-foreground text-lg;
}

/* Animation enhancements */
.animate-gradient-text {
  background-size: 200% 200%;
  animation: gradient-shift 3s ease-in-out infinite;
}

@keyframes gradient-shift {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

/* Responsive theme adjustments */
@media (max-width: 768px) {
  .card-home,
  .stats-card,
  .tech-card {
    @apply rounded-lg;
  }
  
  .section-home {
    @apply py-12;
  }
  
  .section-title {
    @apply text-2xl;
  }
}

/* Dark mode specific enhancements */
html[data-theme="dark"] .card-home,
html[data-theme="dark"] .stats-card,
html[data-theme="dark"] .tech-card {
  @apply bg-card/95;
}

html[data-theme="dark"] .newsletter-card {
  @apply bg-card/95;
}

/* Focus and accessibility enhancements */
.card-home:focus-within,
.stats-card:focus-within,
.tech-card:focus-within {
  @apply ring-2 ring-ring ring-offset-2;
}

.btn-home-primary:focus {
  @apply ring-2 ring-ring ring-offset-2;
}

.tag-filter-badge:focus {
  @apply ring-2 ring-ring ring-offset-2;
}


/* Disable text selection globally (optional) */
body {
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

/* Allow text selection for specific elements */
.prose,
.prose *,
code,
pre,
input,
textarea,
.allow-select {
  -webkit-user-select: text;
  -moz-user-select: text;
  -ms-user-select: text;
  user-select: text;
}

 