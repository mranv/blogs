---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const pageTitle = "404 — Page Not Found";
const pageDescription = "The page you're looking for doesn't exist.";
---
<MainGridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-[50vh]">
        <div class="card-base z-10 px-6 md:px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">
            <div class="text-7xl md:text-9xl font-bold text-[var(--primary)] mb-4">404</div>
            <div class="text-xl md:text-2xl font-bold text-90 mb-2">Page Not Found</div>
            <p class="text-75 max-w-md mb-8">
                The page you're looking for doesn't exist or has been moved.
                Try searching or head back home.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
                <a href="/" class="btn-regular rounded-lg px-6 py-3 font-bold active:scale-95 transition">
                    <div class="flex items-center gap-2">
                        <Icon name="material-symbols:home-outline-rounded" class="text-xl" />
                        <span>Go Home</span>
                    </div>
                </a>
                <a href="/archive/" class="btn-regular rounded-lg px-6 py-3 font-bold active:scale-95 transition">
                    <div class="flex items-center gap-2">
                        <Icon name="material-symbols:list-alt-rounded" class="text-xl" />
                        <span>Browse Archive</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>
