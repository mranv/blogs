---
import { Icon } from "astro-icon/components";
import DecryptedText from "../components/reactbits/DecryptedText";
import FuzzyText from "../components/reactbits/FuzzyText";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const pageTitle = "404 — Page Not Found";
const pageDescription = "The page you're looking for doesn't exist.";
---
<MainGridLayout title={pageTitle} description={pageDescription} art={false}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-[50vh]">
        <div class="card-base z-10 px-6 md:px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">
            <!-- The piece is 84 columns wide and clips on phones, so small screens keep the text 404.
                 Vendored web component: see public/ascii-magic-art/README.md -->
            <ascii-art piece="page-404" size="10" mono class="hidden md:inline-block text-[var(--primary)] mb-4"></ascii-art>
            <div class="md:hidden text-7xl font-heading text-[var(--primary)] mb-4"><FuzzyText client:load>404</FuzzyText></div>
            <div class="eyebrow mb-3"><DecryptedText client:load text="PAGE NOT FOUND" animateOn="view" sequential /></div>
            <!-- Typed, held, taken back (public/ink-type.js). Server text = first phrase. -->
            <div class="font-heading italic text-3xl text-90 h-10 mb-2" aria-hidden="true"
                 data-ink-cycle={JSON.stringify(["lost", "not found", "withered", "gone to seed"])}>lost</div>
            <p class="text-75 max-w-md mb-8">
                The page you're looking for doesn't exist or has been moved.
                Try searching or head back home.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
                <a href="/" class="btn-regular rounded-lg px-6 py-3 font-bold active:scale-95 transition">
                    <div class="flex items-center gap-2">
                        <Icon name="material-symbols:home-outline-rounded" class="text-xl" />
                        <span>Go Home</span>
                    </div>
                </a>
                <a href="/archive/" class="btn-regular rounded-lg px-6 py-3 font-bold active:scale-95 transition">
                    <div class="flex items-center gap-2">
                        <Icon name="material-symbols:list-alt-rounded" class="text-xl" />
                        <span>Browse Archive</span>
                    </div>
                </a>
                <!-- the garden types "lost" in Sumi ink and lets it wither (public/type-garden, ?words=) -->
                <a href="/type-garden/?words=lost,not%20found" target="_blank" rel="noopener" class="btn-regular rounded-lg px-6 py-3 font-bold active:scale-95 transition">
                    <div class="flex items-center gap-2">
                        <Icon name="material-symbols:local-florist-outline-rounded" class="text-xl" />
                        <span>Grow it back</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>
