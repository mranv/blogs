---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Hr from "@components/Hr.astro";
import LazyCard from "@components/LazyCard.astro";
import Socials from "@components/Socials.astro";
import Chatbot from "@components/Chatbot";
import Globe from "@components/Globe";
import getSortedPosts from "@utils/getSortedPosts";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const socialCount = SOCIALS.filter(social => social.active).length;

// List of items to search in for chatbot
const searchList = sortedPosts.map(({ data, slug }) => ({
  title: data.title,
  description: data.description,
  data,
  slug,
}));

// Extract unique tags from all posts for filter section
const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags || []))];

// Featured technologies/skills
const featuredTechnologies = [
  {
    name: "Kubernetes",
    icon: "🚢",
    description: "Container orchestration and management",
  },
  {
    name: "eBPF",
    icon: "🔬",
    description: "Kernel-level observability and security",
  },
  {
    name: "Rust",
    icon: "🦀",
    description: "Systems programming and performance",
  },
  {
    name: "DevSecOps",
    icon: "🔒",
    description: "Security-integrated development practices",
  },
  {
    name: "Cloud Security",
    icon: "☁️",
    description: "Multi-cloud security architecture",
  },
  {
    name: "Terraform",
    icon: "🏗️",
    description: "Infrastructure as Code automation",
  },
];
---

<Layout>
  <Header />

  <!-- Authentication Check -->
  <script>
    // Check if user is authenticated
    if (localStorage.getItem("isAuthenticated") !== "true") {
      window.location.href = "/login";
    }
  </script>

  <!-- Loading State -->
  <div id="loadingState" class="loading-state">
    <div class="text-center">
      <div class="loading-spinner"></div>
      <p class="loading-text">Loading...</p>
    </div>
  </div>

  <script>
    // Hide loading state once page is loaded
    window.addEventListener("load", () => {
      const loadingState = document.getElementById("loadingState");
      if (loadingState) {
        loadingState.style.display = "none";
      }
    });
  </script>

  <main id="main-content" class="w-full bg-background text-foreground">
    <!-- Hero Section - Full Width -->
    <section
      id="hero"
      class="w-full py-16 animate-fade-up bg-background"
      aria-labelledby="hero-heading"
    >
      <div class="container">
        <h1
          id="hero-heading"
          class="mb-6 text-center text-4xl sm:text-5xl lg:text-6xl font-bold text-reveal gradient-text-primary animate-gradient-text"
        >
          Anubhav Gain
        </h1>
        <h2
          class="mb-4 text-center text-xl sm:text-2xl font-semibold text-muted-foreground animate-fade-in-up animate-delay-200"
        >
          DevSecOps Engineer &amp; Cybersecurity Expert
        </h2>
        <p
          class="mb-8 text-center text-lg sm:text-xl text-muted-foreground/90 animate-fade-in-up animate-delay-400"
        >
          Dive beneath the surface of technology—where real innovation happens.
          Exploring the depths of security, automation, and modern
          infrastructure.
        </p>

        <!-- Interactive Globe Section -->
        <div class="globe-container relative flex flex-col items-center">
          <div class="mb-6 text-center">
            <h3
              class="text-lg font-semibold text-primary mb-2 animate-fade-in-up animate-delay-600"
            >
              Global Cybersecurity Network
            </h3>
            <p
              class="text-sm text-muted-foreground animate-fade-in-up animate-delay-700"
            >
              Explore key technology hubs and cybersecurity centers worldwide
            </p>
          </div>

          <Globe
            client:load
            size={500}
            className="mx-auto"
            autoRotate={true}
            rotationSpeed={0.008}
            markers={[
              { location: [37.7749, -122.4194], size: 0.12 }, // San Francisco
              { location: [40.7128, -74.006], size: 0.1 }, // New York
              { location: [51.5074, -0.1278], size: 0.08 }, // London
              { location: [35.6762, 139.6503], size: 0.07 }, // Tokyo
              { location: [52.52, 13.405], size: 0.06 }, // Berlin
              { location: [55.7558, 37.6176], size: 0.05 }, // Moscow
              { location: [39.9042, 116.4074], size: 0.06 }, // Beijing
              { location: [19.076, 72.8777], size: 0.05 }, // Mumbai
              { location: [1.3521, 103.8198], size: 0.05 }, // Singapore
              { location: [-33.8688, 151.2093], size: 0.04 }, // Sydney
              { location: [59.3293, 18.0686], size: 0.04 }, // Stockholm
              { location: [45.5017, -73.5673], size: 0.04 }, // Montreal
            ]}
          />

          <div class="globe-stats">
            <div class="globe-stat-item">
              <div class="globe-stat-icon">🌐</div>
              <div>Global Reach</div>
            </div>
            <div class="globe-stat-item">
              <div class="globe-stat-icon">🔒</div>
              <div>Security Focus</div>
            </div>
            <div class="globe-stat-item">
              <div class="globe-stat-icon">⚡</div>
              <div>Real-time Monitoring</div>
            </div>
            <div class="globe-stat-item">
              <div class="globe-stat-icon">🛡️</div>
              <div>Threat Detection</div>
            </div>
          </div>
        </div>

        <!-- Stats Section with theme-aware Cards -->
        <div class="mt-12 animate-fade-in-up animate-delay-800">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="stats-card">
              <div class="stats-number">
                {sortedPosts.length}+
              </div>
              <div class="text-sm text-muted-foreground">Articles</div>
            </div>
            <div class="stats-card">
              <div class="stats-number">10+</div>
              <div class="text-sm text-muted-foreground">Technologies</div>
            </div>
            <div class="stats-card">
              <div class="stats-number">5+</div>
              <div class="text-sm text-muted-foreground">Years Experience</div>
            </div>
            <div class="stats-card">
              <div class="stats-number">24/7</div>
              <div class="text-sm text-muted-foreground">Security Focus</div>
            </div>
          </div>
        </div>

        <p
          class="mt-12 text-center text-muted-foreground/90 animate-fade-in-up animate-delay-1000"
        >
          Welcome to my technical exploration space. Here you'll find in-depth
          articles on
          <span class="text-primary font-semibold">DevSecOps</span>,
          <span class="text-primary font-semibold">cybersecurity</span>,
          <span class="text-primary font-semibold">cloud security</span>, and
          <span class="text-primary font-semibold">modern infrastructure</span> practices.
        </p>

        {
          socialCount > 0 && (
            <div class="mt-8 flex flex-col items-center justify-center sm:flex-row animate-on-scroll">
              <div class="mb-2 mr-4 font-semibold sm:mb-0 hover-bounce text-foreground">
                Social Links:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <Hr />

    <!-- Featured Technologies Section - Full Width -->
    <section id="technologies" class="section-home w-full bg-background">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="section-title">Core Technologies</h2>
          <p class="section-description animate-delay-100">
            The cutting-edge tools and technologies I work with to build secure,
            scalable solutions
          </p>
        </div>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6"
        >
          {
            featuredTechnologies.map((tech, _index) => (
              <div class="tech-card group">
                <div class="flex flex-col space-y-1.5 p-6">
                  <div class="flex items-center space-x-3">
                    <span class="text-2xl group-hover:scale-110 transition-transform duration-300">
                      {tech.icon}
                    </span>
                    <h3>{tech.name}</h3>
                  </div>
                </div>
                <div class="p-6 pt-0">
                  <p class="text-sm text-muted-foreground">
                    {tech.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="section-home w-full bg-background">
          <div class="container">
            <div class="text-center mb-12">
              <h2 class="section-title">Featured Articles</h2>
              <p class="section-description" style="animation-delay: 0.1s">
                Handpicked articles showcasing cutting-edge security practices
                and innovative solutions
              </p>
            </div>
            <ul class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 stagger-children">
              {featuredPosts.map(({ data, slug }, _index) => (
                <LazyCard
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                  index={_index}
                />
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {recentPosts.length > 0 && <Hr />}

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="section-home w-full bg-background">
          <div class="container">
            <div class="text-center mb-12">
              <h2 class="section-title">Latest Insights</h2>
              <p class="section-description" style="animation-delay: 0.1s">
                Fresh perspectives on emerging security challenges and
                technology trends
              </p>
            </div>
            <div class="text-center mb-8">
              <h3 class="text-lg font-semibold text-primary mb-4">
                Explore by Topic
              </h3>
              <div class="flex flex-wrap justify-center gap-2">
                {allTags.slice(0, 12).map(tag => (
                  <span class="tag-filter-badge">{tag}</span>
                ))}
              </div>
            </div>

            <ul class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 stagger-children">
              {recentPosts.slice(0, 8).map(({ data, slug }, _index) => (
                <LazyCard
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                  index={_index + featuredPosts.length}
                />
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <div class="py-8 text-center bg-background w-full">
      <a href="/posts/" class="btn-home-primary">
        All Posts
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="ml-2 h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>

    <Hr />

    <!-- Newsletter Signup Section - Full Width -->
    <section id="newsletter" class="section-home w-full bg-background">
      <div class="container">
        <div class="text-center">
          <div class="newsletter-card">
            <div class="flex flex-col space-y-1.5 mb-6">
              <h3
                class="text-2xl font-semibold leading-none tracking-tight text-primary"
              >
                Stay Updated
              </h3>
              <p class="text-sm text-muted-foreground">
                Get the latest insights on cybersecurity, DevSecOps, and
                cutting-edge technology delivered to your inbox.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="email"
                placeholder="Enter your email"
                class="newsletter-input"
              />
              <button type="submit" class="btn-home-primary sm:w-auto">
                Subscribe
              </button>
            </div>
            <p class="text-xs text-muted-foreground mt-3">
              No spam, unsubscribe at any time. Your privacy is important to us.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Chatbot client:load searchList={searchList} />
</Layout>

<script>
  // Defer interaction setup to avoid blocking main thread
  if ("requestIdleCallback" in window) {
    requestIdleCallback(() => {
      setupGlobeEnhancements();
      setupNewsletterForm();
      setupCategoryFilters();
    });
  } else {
    // Fallback for browsers without requestIdleCallback
    setTimeout(() => {
      setupGlobeEnhancements();
      setupNewsletterForm();
      setupCategoryFilters();
    }, 1);
  }

  function setupGlobeEnhancements() {
    // Add theme-aware globe updates
    const themeObserver = new MutationObserver(mutations => {
      mutations.forEach(mutation => {
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "data-theme"
        ) {
          const theme = document.documentElement.getAttribute("data-theme");
          // Globe component will automatically update via React props
          console.log("Theme changed to:", theme);
        }
      });
    });

    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // Add globe container animations on scroll
    const globeContainer = document.querySelector(".globe-container");
    if (globeContainer) {
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("animate-in");
            }
          });
        },
        { threshold: 0.3 }
      );

      observer.observe(globeContainer);
    }
  }

  function setupNewsletterForm() {
    const newsletterForm = document.querySelector(
      '#newsletter form, #newsletter button[type="submit"]'
    );
    if (newsletterForm) {
      newsletterForm.addEventListener("click", function (e) {
        e.preventDefault();
        const emailInput = document.querySelector(
          '#newsletter input[type="email"]'
        ) as HTMLInputElement;
        if (emailInput && emailInput.value) {
          // Simple email validation
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (emailRegex.test(emailInput.value)) {
            // In a real implementation, you would send this to your backend
            alert("Thanks for subscribing! We'll send you updates soon.");
            emailInput.value = "";
          } else {
            alert("Please enter a valid email address.");
          }
        } else {
          alert("Please enter your email address.");
        }
      });
    }
  }

  function setupCategoryFilters() {
    const categoryBadges = document.querySelectorAll(
      '#recent-posts .inline-flex[class*="cursor-pointer"]'
    );

    categoryBadges.forEach(badge => {
      badge.addEventListener("click", function (this: HTMLElement) {
        const tag = this.textContent?.trim();
        if (tag) {
          // Navigate to posts page with tag filter
          window.location.href = `/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`;
        }
      });
    });
  }

  // Enhanced accessibility
  document.addEventListener("DOMContentLoaded", function () {
    // Add ARIA labels for interactive elements
    const interactiveElements = document.querySelectorAll(
      '[class*="cursor-pointer"], button, a'
    );
    interactiveElements.forEach(element => {
      if (
        !element.getAttribute("aria-label") &&
        !element.getAttribute("aria-labelledby")
      ) {
        const text = element.textContent?.trim();
        if (text) {
          element.setAttribute("aria-label", text);
        }
      }
    });

    // Keyboard navigation for category badges
    const categoryBadges = document.querySelectorAll(
      '#recent-posts .inline-flex[class*="cursor-pointer"]'
    );
    categoryBadges.forEach(badge => {
      badge.setAttribute("tabindex", "0");
      badge.setAttribute("role", "button");

      badge.addEventListener("keydown", function (e) {
        const keyboardEvent = e as KeyboardEvent;
        if (keyboardEvent.key === "Enter" || keyboardEvent.key === " ") {
          e.preventDefault();
          (badge as HTMLElement).click();
        }
      });
    });
  });
</script>
