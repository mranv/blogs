---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import LazyCard from "@components/LazyCard.astro";
import Socials from "@components/Socials.astro";
import Chatbot from "@components/Chatbot";
import getSortedPosts from "@utils/getSortedPosts";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const socialCount = SOCIALS.filter(social => social.active).length;

// List of items to search in for chatbot
const searchList = sortedPosts.map(({ data, slug }) => ({
  title: data.title,
  description: data.description,
  data,
  slug,
}));
---

<Layout>
  <Header />
  <main id="main-content">
    <section
      id="hero"
      class="py-12 animate-fade-up"
      aria-labelledby="hero-heading"
    >
      <h1
        id="hero-heading"
        class="mb-6 text-center text-4xl sm:text-5xl lg:text-6xl font-bold text-reveal bg-gradient-to-r from-primary via-accent to-primary bg-clip-text text-transparent animate-gradient-text"
      >
        Anubhav Gain
      </h1>
      <h2
        class="mb-4 text-center text-xl sm:text-2xl font-semibold text-muted-foreground animate-fade-in-up"
        style="animation-delay: 0.2s"
      >
        DevSecOps Engineer &amp; Cybersecurity Expert
      </h2>
      <p
        class="mb-8 text-center text-lg sm:text-xl text-muted-foreground/90 animate-fade-in-up max-w-3xl mx-auto"
        style="animation-delay: 0.4s"
      >
        Dive beneath the surface of technology—where real innovation happens.
        Exploring the depths of security, automation, and modern infrastructure.
      </p>

      <div class="video-container relative mx-auto max-w-3xl animate-scale-in">
        <video
          id="myVideo"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          width="1920"
          height="1080"
          class="w-full rounded-lg shadow-lg"
          poster="/assets/video-poster.jpg"
        >
          <source src="/assets/video.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <button
          id="unmuteBtn"
          class="absolute bottom-4 left-1/2 -translate-x-1/2 transform rounded bg-white px-4 py-2 font-semibold text-gray-800 transition-colors hover:bg-gray-200"
        >
          Unmute
        </button>
      </div>

      <!-- Stats Section -->
      <div
        class="mx-auto mt-12 max-w-4xl animate-fade-in-up"
        style="animation-delay: 0.8s"
      >
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div
            class="p-4 rounded-xl bg-card/50 backdrop-blur-sm border border-border/30 hover:border-primary/30 transition-all duration-300 hover:scale-105"
          >
            <div class="text-2xl font-bold text-primary">
              {sortedPosts.length}+
            </div>
            <div class="text-sm text-muted-foreground">Articles</div>
          </div>
          <div
            class="p-4 rounded-xl bg-card/50 backdrop-blur-sm border border-border/30 hover:border-primary/30 transition-all duration-300 hover:scale-105"
          >
            <div class="text-2xl font-bold text-primary">10+</div>
            <div class="text-sm text-muted-foreground">Technologies</div>
          </div>
          <div
            class="p-4 rounded-xl bg-card/50 backdrop-blur-sm border border-border/30 hover:border-primary/30 transition-all duration-300 hover:scale-105"
          >
            <div class="text-2xl font-bold text-primary">5+</div>
            <div class="text-sm text-muted-foreground">Years Experience</div>
          </div>
          <div
            class="p-4 rounded-xl bg-card/50 backdrop-blur-sm border border-border/30 hover:border-primary/30 transition-all duration-300 hover:scale-105"
          >
            <div class="text-2xl font-bold text-primary">24/7</div>
            <div class="text-sm text-muted-foreground">Security Focus</div>
          </div>
        </div>
      </div>

      <p
        class="mx-auto mt-12 max-w-3xl text-center text-muted-foreground/90 animate-fade-in-up"
        style="animation-delay: 1s"
      >
        Welcome to my technical exploration space. Here you'll find in-depth
        articles on
        <span class="text-primary font-semibold">DevSecOps</span>,
        <span class="text-primary font-semibold">cybersecurity</span>,
        <span class="text-primary font-semibold">cloud security</span>, and
        <span class="text-primary font-semibold">modern infrastructure</span> practices.
      </p>

      {
        socialCount > 0 && (
          <div class="mt-8 flex flex-col items-center justify-center sm:flex-row animate-on-scroll">
            <div class="mb-2 mr-4 font-semibold sm:mb-0 hover-bounce">
              Social Links:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="py-16">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-primary mb-4 animate-fade-in-up">
              Featured Articles
            </h2>
            <p
              class="text-muted-foreground max-w-2xl mx-auto animate-fade-in-up"
              style="animation-delay: 0.1s"
            >
              Handpicked articles showcasing cutting-edge security practices and
              innovative solutions
            </p>
          </div>
          <ul class="mx-auto grid max-w-4xl gap-6 px-4 sm:grid-cols-2 stagger-children">
            {featuredPosts.map(({ data, slug }, index) => (
              <LazyCard
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
                index={index}
              />
            ))}
          </ul>
        </section>
      )
    }

    {recentPosts.length > 0 && <Hr />}

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="py-16">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-primary mb-4 animate-fade-in-up">
              Latest Insights
            </h2>
            <p
              class="text-muted-foreground max-w-2xl mx-auto animate-fade-in-up"
              style="animation-delay: 0.1s"
            >
              Fresh perspectives on emerging security challenges and technology
              trends
            </p>
          </div>
          <ul class="mx-auto grid max-w-4xl gap-6 px-4 sm:grid-cols-2 stagger-children">
            {recentPosts.slice(0, 8).map(({ data, slug }, index) => (
              <LazyCard
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
                index={index + featuredPosts.length}
              />
            ))}
          </ul>
        </section>
      )
    }

    <div class="py-8 text-center">
      <LinkButton
        href="/posts/"
        className="inline-flex items-center rounded px-4 py-2 font-bold transition-colors"
      >
        All Posts
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="ml-2 h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
  <Chatbot client:load searchList={searchList} />
</Layout>

<style>
  #main-content {
    @apply bg-skin-fill text-skin-base;
  }

  .animate-gradient-text {
    background-size: 200% 200%;
    animation: gradientShift 4s ease-in-out infinite;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .stagger-children > * {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .stagger-children > *:nth-child(1) {
    animation-delay: 0.1s;
  }
  .stagger-children > *:nth-child(2) {
    animation-delay: 0.2s;
  }
  .stagger-children > *:nth-child(3) {
    animation-delay: 0.3s;
  }
  .stagger-children > *:nth-child(4) {
    animation-delay: 0.4s;
  }
  .stagger-children > *:nth-child(5) {
    animation-delay: 0.5s;
  }
  .stagger-children > *:nth-child(6) {
    animation-delay: 0.6s;
  }
  .stagger-children > *:nth-child(7) {
    animation-delay: 0.7s;
  }
  .stagger-children > *:nth-child(8) {
    animation-delay: 0.8s;
  }

  .link-button {
    @apply bg-skin-accent text-skin-inverted transition-all duration-300 hover:opacity-90 hover:scale-105 hover:shadow-lg;
  }

  #unmuteBtn {
    @apply bg-skin-fill text-skin-base hover:bg-skin-accent hover:text-skin-inverted transition-all duration-300 hover:scale-105;
  }

  .video-container {
    @apply relative overflow-hidden rounded-2xl shadow-2xl;
  }

  .video-container::before {
    content: "";
    @apply absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-accent/10 pointer-events-none z-10;
  }

  /* Hover effects for stats cards */
  .stats-card {
    @apply transition-all duration-300 hover:shadow-xl hover:border-primary/50;
  }

  .stats-card:hover .stats-number {
    @apply scale-110;
  }
</style>

<script>
  // Defer video interaction setup to avoid blocking main thread
  if ("requestIdleCallback" in window) {
    requestIdleCallback(() => {
      const video = document.getElementById(
        "myVideo"
      ) as HTMLVideoElement | null;
      const unmuteBtn = document.getElementById("unmuteBtn");

      if (video && unmuteBtn) {
        unmuteBtn.addEventListener("click", function () {
          video.muted = false;
          video.play().catch(err => console.log("Video play failed:", err));
          unmuteBtn.style.display = "none";
        });
      }
    });
  } else {
    // Fallback for browsers without requestIdleCallback
    setTimeout(() => {
      const video = document.getElementById(
        "myVideo"
      ) as HTMLVideoElement | null;
      const unmuteBtn = document.getElementById("unmuteBtn");

      if (video && unmuteBtn) {
        unmuteBtn.addEventListener("click", function () {
          video.muted = false;
          video.play().catch(err => console.log("Video play failed:", err));
          unmuteBtn.style.display = "none";
        });
      }
    }, 1);
  }
</script>
