---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Hr from "@components/Hr.astro";
import LazyCard from "@components/LazyCard.astro";
import Socials from "@components/Socials.astro";
import Chatbot from "@components/Chatbot";
import Globe from "@components/Globe";
import getSortedPosts from "@utils/getSortedPosts";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const socialCount = SOCIALS.filter(social => social.active).length;

// List of items to search in for chatbot
const searchList = sortedPosts.map(({ data, slug }) => ({
  title: data.title,
  description: data.description,
  data,
  slug,
}));

// Extract unique tags from all posts for filter section
const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags || []))];

// Featured technologies/skills
const featuredTechnologies = [
  {
    name: "Kubernetes",
    icon: "🚢",
    description: "Container orchestration and management",
  },
  {
    name: "eBPF",
    icon: "🔬",
    description: "Kernel-level observability and security",
  },
  {
    name: "Rust",
    icon: "🦀",
    description: "Systems programming and performance",
  },
  {
    name: "DevSecOps",
    icon: "🔒",
    description: "Security-integrated development practices",
  },
  {
    name: "Cloud Security",
    icon: "☁️",
    description: "Multi-cloud security architecture",
  },
  {
    name: "Terraform",
    icon: "🏗️",
    description: "Infrastructure as Code automation",
  },
];
---

<Layout>
  <Header />

  <!-- Authentication Check -->
  <script>
    // Check if user is authenticated
    if (localStorage.getItem("isAuthenticated") !== "true") {
      window.location.href = "/login";
    }
  </script>

  <!-- Loading State -->
  <div
    id="loadingState"
    class="fixed inset-0 bg-slate-900 flex items-center justify-center z-50"
  >
    <div class="text-center">
      <div
        class="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-500 mx-auto mb-4"
      >
      </div>
      <p class="text-white text-lg">Loading...</p>
    </div>
  </div>

  <script>
    // Hide loading state once page is loaded
    window.addEventListener("load", () => {
      const loadingState = document.getElementById("loadingState");
      if (loadingState) {
        loadingState.style.display = "none";
      }
    });
  </script>

  <main id="main-content">
    <section
      id="hero"
      class="py-12 animate-fade-up"
      aria-labelledby="hero-heading"
    >
      <h1
        id="hero-heading"
        class="mb-6 text-center text-4xl sm:text-5xl lg:text-6xl font-bold text-reveal bg-gradient-to-r from-primary via-accent to-primary bg-clip-text text-transparent animate-gradient-text"
      >
        Anubhav Gain
      </h1>
      <h2
        class="mb-4 text-center text-xl sm:text-2xl font-semibold text-muted-foreground animate-fade-in-up animate-delay-200"
      >
        DevSecOps Engineer &amp; Cybersecurity Expert
      </h2>
      <p
        class="mb-8 text-center text-lg sm:text-xl text-muted-foreground/90 animate-fade-in-up animate-delay-400 mx-auto px-4"
      >
        Dive beneath the surface of technology—where real innovation happens.
        Exploring the depths of security, automation, and modern infrastructure.
      </p>

      <!-- Interactive Globe Section -->
      <div
        class="globe-container relative mx-auto flex flex-col items-center animate-scale-in"
      >
        <div class="mb-6 text-center">
          <h3
            class="text-lg font-semibold text-primary mb-2 animate-fade-in-up animate-delay-600"
          >
            Global Cybersecurity Network
          </h3>
          <p
            class="text-sm text-muted-foreground animate-fade-in-up animate-delay-700"
          >
            Explore key technology hubs and cybersecurity centers worldwide
          </p>
        </div>

        <Globe
          client:load
          size={500}
          className="mx-auto"
          autoRotate={true}
          rotationSpeed={0.008}
          markers={[
            { location: [37.7749, -122.4194], size: 0.12 }, // San Francisco
            { location: [40.7128, -74.006], size: 0.1 }, // New York
            { location: [51.5074, -0.1278], size: 0.08 }, // London
            { location: [35.6762, 139.6503], size: 0.07 }, // Tokyo
            { location: [52.52, 13.405], size: 0.06 }, // Berlin
            { location: [55.7558, 37.6176], size: 0.05 }, // Moscow
            { location: [39.9042, 116.4074], size: 0.06 }, // Beijing
            { location: [19.076, 72.8777], size: 0.05 }, // Mumbai
            { location: [1.3521, 103.8198], size: 0.05 }, // Singapore
            { location: [-33.8688, 151.2093], size: 0.04 }, // Sydney
            { location: [59.3293, 18.0686], size: 0.04 }, // Stockholm
            { location: [45.5017, -73.5673], size: 0.04 }, // Montreal
          ]}
        />

        <div
          class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-xs text-muted-foreground animate-fade-in-up animate-delay-800"
        >
          <div class="p-2">
            <div class="text-primary font-semibold">🌐</div>
            <div>Global Reach</div>
          </div>
          <div class="p-2">
            <div class="text-primary font-semibold">🔒</div>
            <div>Security Focus</div>
          </div>
          <div class="p-2">
            <div class="text-primary font-semibold">⚡</div>
            <div>Real-time Monitoring</div>
          </div>
          <div class="p-2">
            <div class="text-primary font-semibold">🛡️</div>
            <div>Threat Detection</div>
          </div>
        </div>
      </div>

      <!-- Stats Section with shadcn Cards -->
      <div class="mx-auto mt-12 animate-fade-in-up animate-delay-800">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div
            class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 backdrop-blur-sm bg-card/90 p-4 hover:border-primary/30"
          >
            <div class="text-2xl font-bold text-primary stats-number">
              {sortedPosts.length}+
            </div>
            <div class="text-sm text-muted-foreground">Articles</div>
          </div>
          <div
            class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 backdrop-blur-sm bg-card/90 p-4 hover:border-primary/30"
          >
            <div class="text-2xl font-bold text-primary stats-number">10+</div>
            <div class="text-sm text-muted-foreground">Technologies</div>
          </div>
          <div
            class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 backdrop-blur-sm bg-card/90 p-4 hover:border-primary/30"
          >
            <div class="text-2xl font-bold text-primary stats-number">5+</div>
            <div class="text-sm text-muted-foreground">Years Experience</div>
          </div>
          <div
            class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 backdrop-blur-sm bg-card/90 p-4 hover:border-primary/30"
          >
            <div class="text-2xl font-bold text-primary stats-number">24/7</div>
            <div class="text-sm text-muted-foreground">Security Focus</div>
          </div>
        </div>
      </div>

      <p
        class="mx-auto mt-12 text-center text-muted-foreground/90 animate-fade-in-up animate-delay-1000"
      >
        Welcome to my technical exploration space. Here you'll find in-depth
        articles on
        <span class="text-primary font-semibold">DevSecOps</span>,
        <span class="text-primary font-semibold">cybersecurity</span>,
        <span class="text-primary font-semibold">cloud security</span>, and
        <span class="text-primary font-semibold">modern infrastructure</span> practices.
      </p>

      {
        socialCount > 0 && (
          <div class="mt-8 flex flex-col items-center justify-center sm:flex-row animate-on-scroll">
            <div class="mb-2 mr-4 font-semibold sm:mb-0 hover-bounce">
              Social Links:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <!-- Featured Technologies Section -->
    <section id="technologies" class="py-16">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary mb-4 animate-fade-in-up">
          Core Technologies
        </h2>
        <p
          class="text-muted-foreground mx-auto animate-fade-in-up animate-delay-100"
        >
          The cutting-edge tools and technologies I work with to build secure,
          scalable solutions
        </p>
      </div>
      <div
        class="mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 px-4"
      >
        {
          featuredTechnologies.map((tech, _index) => (
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 backdrop-blur-sm bg-card/90 group tech-card">
              <div class="flex flex-col space-y-1.5 p-6">
                <div class="flex items-center space-x-3">
                  <span class="text-2xl group-hover:scale-110 transition-transform duration-300">
                    {tech.icon}
                  </span>
                  <h3 class="text-xl font-semibold leading-none tracking-tight">
                    {tech.name}
                  </h3>
                </div>
              </div>
              <div class="p-6 pt-0">
                <p class="text-sm text-muted-foreground">{tech.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="py-16">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-primary mb-4 animate-fade-in-up">
              Featured Articles
            </h2>
            <p
              class="text-muted-foreground mx-auto animate-fade-in-up"
              style="animation-delay: 0.1s"
            >
              Handpicked articles showcasing cutting-edge security practices and
              innovative solutions
            </p>
          </div>
          <ul class="mx-auto grid gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 stagger-children">
            {featuredPosts.map(({ data, slug }, _index) => (
              <LazyCard
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
                index={_index}
              />
            ))}
          </ul>
        </section>
      )
    }

    {recentPosts.length > 0 && <Hr />}

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="py-16">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-primary mb-4 animate-fade-in-up">
              Latest Insights
            </h2>
            <p
              class="text-muted-foreground mx-auto animate-fade-in-up"
              style="animation-delay: 0.1s"
            >
              Fresh perspectives on emerging security challenges and technology
              trends
            </p>
          </div>
          <div class="text-center mb-8">
            <h3 class="text-lg font-semibold text-primary mb-4">
              Explore by Topic
            </h3>
            <div class="flex flex-wrap justify-center gap-2 mx-auto px-4">
              {allTags.slice(0, 12).map(tag => (
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80 cursor-pointer hover:scale-105 transition-transform duration-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <ul class="mx-auto grid gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 stagger-children">
            {recentPosts.slice(0, 8).map(({ data, slug }, _index) => (
              <LazyCard
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
                index={_index + featuredPosts.length}
              />
            ))}
          </ul>
        </section>
      )
    }

    <div class="py-8 text-center">
      <a
        href="/posts/"
        class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 relative overflow-hidden bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 hover:shadow-md before:absolute before:inset-0 before:bg-gradient-to-r before:from-white/0 before:via-white/20 before:to-white/0 before:translate-x-[-200%] hover:before:translate-x-[200%] before:transition-transform before:duration-700 h-10 px-5 py-2"
      >
        All Posts
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="ml-2 h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>

    <Hr />

    <!-- Newsletter Signup Section -->
    <section id="newsletter" class="py-16">
      <div class="mx-auto text-center">
        <div
          class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-lg backdrop-blur-sm bg-card/90 p-8"
        >
          <div class="flex flex-col space-y-1.5 mb-6">
            <h3
              class="text-2xl font-semibold leading-none tracking-tight text-primary"
            >
              Stay Updated
            </h3>
            <p class="text-sm text-muted-foreground">
              Get the latest insights on cybersecurity, DevSecOps, and
              cutting-edge technology delivered to your inbox.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              placeholder="Enter your email"
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 flex-1"
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 relative overflow-hidden bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 hover:shadow-md before:absolute before:inset-0 before:bg-gradient-to-r before:from-white/0 before:via-white/20 before:to-white/0 before:translate-x-[-200%] hover:before:translate-x-[200%] before:transition-transform before:duration-700 h-10 px-5 py-2 sm:w-auto"
            >
              Subscribe
            </button>
          </div>
          <p class="text-xs text-muted-foreground mt-3">
            No spam, unsubscribe at any time. Your privacy is important to us.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Chatbot client:load searchList={searchList} />
</Layout>

<script>
  // Defer interaction setup to avoid blocking main thread
  if ("requestIdleCallback" in window) {
    requestIdleCallback(() => {
      setupGlobeEnhancements();
      setupNewsletterForm();
      setupCategoryFilters();
    });
  } else {
    // Fallback for browsers without requestIdleCallback
    setTimeout(() => {
      setupGlobeEnhancements();
      setupNewsletterForm();
      setupCategoryFilters();
    }, 1);
  }

  function setupGlobeEnhancements() {
    // Add theme-aware globe updates
    const themeObserver = new MutationObserver(mutations => {
      mutations.forEach(mutation => {
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "data-theme"
        ) {
          const theme = document.documentElement.getAttribute("data-theme");
          // Globe component will automatically update via React props
          console.log("Theme changed to:", theme);
        }
      });
    });

    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // Add globe container animations on scroll
    const globeContainer = document.querySelector(".globe-container");
    if (globeContainer) {
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("animate-in");
            }
          });
        },
        { threshold: 0.3 }
      );

      observer.observe(globeContainer);
    }
  }

  function setupNewsletterForm() {
    const newsletterForm = document.querySelector(
      '#newsletter form, #newsletter button[type="submit"]'
    );
    if (newsletterForm) {
      newsletterForm.addEventListener("click", function (e) {
        e.preventDefault();
        const emailInput = document.querySelector(
          '#newsletter input[type="email"]'
        ) as HTMLInputElement;
        if (emailInput && emailInput.value) {
          // Simple email validation
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (emailRegex.test(emailInput.value)) {
            // In a real implementation, you would send this to your backend
            alert("Thanks for subscribing! We'll send you updates soon.");
            emailInput.value = "";
          } else {
            alert("Please enter a valid email address.");
          }
        } else {
          alert("Please enter your email address.");
        }
      });
    }
  }

  function setupCategoryFilters() {
    const categoryBadges = document.querySelectorAll(
      '#recent-posts .inline-flex[class*="cursor-pointer"]'
    );

    categoryBadges.forEach(badge => {
      badge.addEventListener("click", function (this: HTMLElement) {
        const tag = this.textContent?.trim();
        if (tag) {
          // Navigate to posts page with tag filter
          window.location.href = `/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`;
        }
      });
    });
  }

  // Enhanced accessibility
  document.addEventListener("DOMContentLoaded", function () {
    // Add ARIA labels for interactive elements
    const interactiveElements = document.querySelectorAll(
      '[class*="cursor-pointer"], button, a'
    );
    interactiveElements.forEach(element => {
      if (
        !element.getAttribute("aria-label") &&
        !element.getAttribute("aria-labelledby")
      ) {
        const text = element.textContent?.trim();
        if (text) {
          element.setAttribute("aria-label", text);
        }
      }
    });

    // Keyboard navigation for category badges
    const categoryBadges = document.querySelectorAll(
      '#recent-posts .inline-flex[class*="cursor-pointer"]'
    );
    categoryBadges.forEach(badge => {
      badge.setAttribute("tabindex", "0");
      badge.setAttribute("role", "button");

      badge.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          (badge as HTMLElement).click();
        }
      });
    });
  });
</script>
