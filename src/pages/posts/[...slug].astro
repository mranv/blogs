---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import CountUp from "../../components/reactbits/CountUp";
import PostMetadata from "../../components/PostMeta.astro";
import { siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const allPosts = await getSortedPosts();
	// Posts imported twice under two slugs share a title. The shortest slug (ties: alphabetical)
	// is the canonical one; the others point rel=canonical at it so search engines index a
	// single copy. astro.config.mjs applies the same rule to drop the copies from the sitemap.
	// ponytail: title equality is the whole duplicate test; compare bodies if it ever misfires.
	const canonicalSlug = new Map<string, string>();
	for (const { slug, data } of allPosts) {
		const best = canonicalSlug.get(data.title);
		if (!best || slug.length < best.length || (slug.length === best.length && slug < best)) canonicalSlug.set(data.title, slug);
	}
	return allPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post, canonicalSlug: canonicalSlug.get(post.data.title) as string },
	}));
}

const { post: entry, canonicalSlug } = Astro.props;
const canonical = canonicalSlug === entry.slug ? undefined : new URL(`posts/${canonicalSlug}/`, Astro.site).href;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();

// Meta description is always generated, never shared between posts: the frontmatter one when
// it is long enough to fill a search snippet (70+ chars), else the post's opening paragraphs
// (remark-excerpt plugin), else a sentence built from title, category and tags (posts that
// open with code or a list have no paragraphs). Layout.astro clamps the length.
const written = entry.data.description.trim();
const excerpt = (remarkPluginFrontmatter.excerpt || "").trim();
let description = written.length >= 70 || excerpt.length <= written.length ? written : excerpt;
if (description.length < 70) {
	const topics = [entry.data.category, ...(entry.data.tags || [])].filter(Boolean).slice(0, 4).join(", ");
	description = `${entry.data.title}: ${description ? `${description.replace(/[.:]$/, "")}. ` : ""}${topics ? `Notes on ${topics} ` : "Notes "}by Anubhav Gain.`;
}
// Exactly one <h1> per post: the title is the h1 unless the markdown body brings its own `# `.
const TitleTag = headings.some((h) => h.depth === 1) ? "div" : "h1";
const personId = new URL("#person", Astro.site).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description,
	keywords: entry.data.tags ? entry.data.tags.join(", ") : "",
	// Full Person node lives in Layout.astro; this is a reference to it.
	author: { "@type": "Person", "@id": personId, name: "Anubhav Gain", url: new URL("about/", Astro.site).href },
	publisher: { "@id": personId },
	datePublished: formatDateToYYYYMMDD(entry.data.pubDatetime || entry.data.published || new Date()),
	dateModified: entry.data.modDatetime ? formatDateToYYYYMMDD(entry.data.modDatetime) : formatDateToYYYYMMDD(entry.data.pubDatetime || entry.data.published || new Date()),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// Same rule as Layout.astro: absolute cover, else the generated card (scripts/og/build.mjs).
	image: /^https?:\/\//.test(entry.data.image) ? entry.data.image : new URL(`og/posts/${entry.slug}.png`, Astro.site).href,
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": `${Astro.site}posts/${entry.slug}/`
	},
	articleSection: entry.data.category || "Technology",
	wordCount: remarkPluginFrontmatter.words,
	timeRequired: `PT${remarkPluginFrontmatter.minutes}M`
};

const publishedISO = formatDateToYYYYMMDD(entry.data.pubDatetime || entry.data.published || new Date());
const modifiedISO = entry.data.modDatetime
	? formatDateToYYYYMMDD(entry.data.modDatetime)
	: formatDateToYYYYMMDD(entry.data.pubDatetime || entry.data.published || new Date());
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={description} canonical={canonical} lang={entry.data.lang} image={entry.data.image} setOGTypeArticle={true} articleData={{ published: publishedISO, modified: modifiedISO, tags: entry.data.tags }} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm"><CountUp client:visible to={remarkPluginFrontmatter.words} separator="," duration={1} /> {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        <CountUp client:visible to={remarkPluginFrontmatter.minutes} duration={1} /> {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <TitleTag
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-heading mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90">
                    {entry.data.title}
                </TitleTag>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.pubDatetime || entry.data.published || new Date()}
                        updated={entry.data.modDatetime || entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                        author={entry.data.author}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} alt={`Cover image for ${entry.data.title}`} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.pubDatetime || entry.data.published || new Date()} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        {entry.data.nextSlug ? <a href={getPostUrlBySlug(entry.data.nextSlug)}
           class="w-full font-bold overflow-hidden active:scale-95">
            <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)]">
                    {entry.data.nextTitle}
                </div>
            </div>
        </a> : <div class="w-full"></div>}

        {entry.data.prevSlug ? <a href={getPostUrlBySlug(entry.data.prevSlug)}
           class="w-full font-bold overflow-hidden active:scale-95">
            <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)]">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem]" />
            </div>
        </a> : <div class="w-full"></div>}
    </div>

</MainGridLayout>
