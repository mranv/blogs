---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import AudioVisualizerGrid from "../components/AudioVisualizerGrid.svelte";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content, headings } = await render(aboutPost);

const aboutPageTitle = "About Anubhav Gain - Security Software Engineer & Security Expert";
const aboutPageDescription = "Learn about Anubhav Gain, Security Software Engineer at Infopercept, CEO at TechAnv Consulting, DevSecOps Expert, XDR/OXDR Platform Architect with 222+ Research Citations.";
---
<MainGridLayout title={aboutPageTitle} description={aboutPageDescription} headings={headings}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <!-- Grid Visualizer as background decoration -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-30 overflow-hidden">
            <AudioVisualizerGrid
                client:idle
                size={400}
                color="#1FD5F9"
                colorShift={0.3}
                rowCount={15}
                columnCount={15}
                radius={60}
                state="idle"
            />
        </div>
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
