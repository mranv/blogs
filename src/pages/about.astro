---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import DotField from "../components/reactbits/DotField";
import ShinyText from "../components/reactbits/ShinyText";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content, headings } = await render(aboutPost);

const aboutPageTitle = "About Anubhav Gain - Security Software Engineer & Security Expert";
const aboutPageDescription = "Learn about Anubhav Gain, Security Software Engineer at Infopercept, CEO at TechAnv Consulting, DevSecOps Expert, XDR/OXDR Platform Architect with 222+ Research Citations.";
---
<MainGridLayout title={aboutPageTitle} description={aboutPageDescription} headings={headings} art={false}>
    <!-- Page banner replaces the ASCII strip here. WebGL canvas: literal colours, see reactbits/README.md -->
    <div class="card-base relative mb-4 h-40 overflow-hidden" aria-hidden="true">
        <DotField client:visible gradientFrom="#958f87" gradientTo="#ce5e32" glowColor="#ce5e32" holdToZoom={false} />
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none font-heading italic text-5xl">
            <ShinyText client:visible text="About" color="#958f87" shineColor="#ce5e32" speed={3} />
            <!-- Typed, held, taken back, next phrase (public/ink-type.js). Server text = first phrase. -->
            <div class="mt-3 h-4 font-mono not-italic text-[0.6875rem] tracking-[0.18em] uppercase text-[var(--ink-muted)]"
                 data-ink-cycle={JSON.stringify(["security, written from the kernel up", "Rust and eBPF, close to the metal", "XDR you can reason about", "detections written as code"])}>security, written from the kernel up</div>
        </div>
    </div>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
