---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import CountUp from "../components/reactbits/CountUp";
import { getSortedPostsList, getTagList, getCategoryList } from "../utils/content-utils";


const sortedPostsList = await getSortedPostsList();
const tagList = await getTagList();
const categoryList = await getCategoryList();

const tags = tagList.map(tag => tag.name);
const categories = categoryList.map(cat => cat.name);
const stats: [number, string][] = [[sortedPostsList.length, "posts"], [tags.length, "tags"], [categories.length, "categories"]];
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <div class="card-base px-6 md:px-9 py-5 mb-4 flex flex-wrap items-baseline gap-x-10 gap-y-2 onload-animation">
        {stats.map(([n, label]) => (
            <div><span class="font-heading text-3xl text-90"><CountUp client:visible to={n} separator="," duration={1.5} /></span> <span class="eyebrow">{label}</span></div>
        ))}
    </div>
    <ArchivePanel 
        sortedPosts={sortedPostsList} 
        tags={tags} 
        categories={categories} 
        client:only="svelte"></ArchivePanel>
</MainGridLayout>

