---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import BlogCard from "@components/BlogCard.tsx";
import { AuthorCard, AuthorBio, AuthorHero } from "@components/author";
import { TagCloud, EnhancedTag } from "@components/tags";
import {
  FadeIn,
  SlideIn,
  ScaleIn,
  StaggerChildren,
} from "@components/animations";
import Search from "@components/Search.tsx";
import ThemeToggle from "@components/ThemeToggle.astro";
import { SITE } from "@config";
import { getCollection } from "astro:content";

export const prerender = true;

// Get sample blog posts for showcase
const posts = await getCollection("blog");
const samplePosts = posts.slice(0, 6);

// Create searchList for Search component
const searchList = posts.map(({ data, slug }) => ({
  title: data.title,
  description: data.description,
  data,
  slug,
}));

const pageTitle = "Component Showcase - Visual Demo";
const pageDescription =
  "Visual showcase of all enhanced blog components demonstrating design, animations, and interactive features";

// Sample data
const sampleAuthor = {
  name: "Anubhav Gain",
  title: "Senior Security Engineer",
  bio: "Senior Security Engineer and Cloud Architect passionate about DevSecOps, automation, and emerging technologies. Sharing insights on cybersecurity, cloud infrastructure, and development best practices.",
  avatar: "/assets/anubhavgain.webp",
  location: "San Francisco, CA",
  company: "Tech Corp",
  email: "anubhav@example.com",
  socials: [
    {
      name: "Twitter" as const,
      href: "https://twitter.com/anubhavgain",
      active: true,
      linkTitle: "Follow on Twitter",
    },
    {
      name: "Github" as const,
      href: "https://github.com/mranv",
      active: true,
      linkTitle: "Follow on GitHub",
    },
    {
      name: "LinkedIn" as const,
      href: "https://linkedin.com/in/anubhavgain",
      active: true,
      linkTitle: "Connect on LinkedIn",
    },
  ],
};

const sampleTags = [
  {
    tag: "cybersecurity",
    tagName: "cybersecurity",
    count: 25,
    popularity: 0.9,
  },
  { tag: "cloud", tagName: "cloud", count: 20, popularity: 0.8 },
  { tag: "devops", tagName: "devops", count: 18, popularity: 0.7 },
  { tag: "automation", tagName: "automation", count: 15, popularity: 0.6 },
  { tag: "kubernetes", tagName: "kubernetes", count: 12, popularity: 0.5 },
  { tag: "aws", tagName: "aws", count: 10, popularity: 0.4 },
  { tag: "docker", tagName: "docker", count: 8, popularity: 0.3 },
  { tag: "security", tagName: "security", count: 22, popularity: 0.85 },
];
---

<Layout
  title={pageTitle}
  author={SITE.author}
  description={pageDescription}
  ogImage={SITE.ogImage}
>
  <Header activeNav="about" />
  <Main
    pageTitle="Component Showcase"
    titleTransition="showcase"
    pageDesc="Visual demonstration of all enhanced blog components with interactive features and animations"
  >
    <!-- Navigation -->
    <nav
      class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-4 mb-8"
    >
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="#hero-section"
          class="px-4 py-2 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 rounded-md transition-colors"
        >
          Hero Components
        </a>
        <a
          href="#blog-cards"
          class="px-4 py-2 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 rounded-md transition-colors"
        >
          Blog Cards
        </a>
        <a
          href="#author-components"
          class="px-4 py-2 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 rounded-md transition-colors"
        >
          Author Components
        </a>
        <a
          href="#tag-components"
          class="px-4 py-2 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 rounded-md transition-colors"
        >
          Tag Components
        </a>
        <a
          href="#animations"
          class="px-4 py-2 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 rounded-md transition-colors"
        >
          Animations
        </a>
        <a
          href="#interactive"
          class="px-4 py-2 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 rounded-md transition-colors"
        >
          Interactive Elements
        </a>
      </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero-section" class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Hero Components
        </h2>
      </FadeIn>

      <div class="space-y-8">
        <!-- Author Hero -->
        <div
          class="bg-gradient-to-r from-primary to-chart-2 rounded-lg overflow-hidden"
        >
          <AuthorHero
            client:load
            author={sampleAuthor}
            stats={{ experience: "10+", clients: 100, projects: 50 }}
          />
        </div>

        <!-- Author Bio -->
        <SlideIn client:load direction="left">
          <AuthorBio client:load author={sampleAuthor} />
        </SlideIn>
      </div>
    </section>

    <!-- Blog Cards Section -->
    <section id="blog-cards" class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Blog Card Variations
        </h2>
      </FadeIn>

      <StaggerChildren client:load>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            samplePosts.map((post, _index) => (
              <div>
                <BlogCard
                  client:load
                  href={`/posts/${post.slug}`}
                  frontmatter={post.data}
                />
              </div>
            ))
          }
        </div>
      </StaggerChildren>
    </section>

    <!-- Author Components Section -->
    <section id="author-components" class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Author Components
        </h2>
      </FadeIn>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Author Card Variants -->
        <div class="space-y-6">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            Author Cards
          </h3>

          <SlideIn client:load direction="left">
            <AuthorCard client:load author={sampleAuthor} variant="default" />
          </SlideIn>

          <SlideIn client:load direction="left" delay={100}>
            <AuthorCard client:load author={sampleAuthor} variant="compact" />
          </SlideIn>

          <SlideIn client:load direction="left" delay={200}>
            <AuthorCard client:load author={sampleAuthor} variant="detailed" />
          </SlideIn>
        </div>

        <!-- Author Bio Variants -->
        <div class="space-y-6">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            Author Bio
          </h3>

          <SlideIn client:load direction="right">
            <AuthorBio client:load author={sampleAuthor} />
          </SlideIn>
        </div>
      </div>
    </section>

    <!-- Tag Components Section -->
    <section id="tag-components" class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Tag Components
        </h2>
      </FadeIn>

      <div class="space-y-8">
        <!-- Tag Cloud -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
            Tag Cloud
          </h3>
          <ScaleIn client:load>
            <TagCloud client:load tags={sampleTags} maxTags={8} />
          </ScaleIn>
        </div>

        <!-- Individual Tags -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
            Enhanced Tags
          </h3>
          <StaggerChildren client:load>
            <div class="flex flex-wrap gap-3">
              {
                sampleTags
                  .slice(0, 6)
                  .map((tag, index) => (
                    <EnhancedTag
                      client:load
                      tag={tag}
                      size={
                        index % 3 === 0 ? "lg" : index % 3 === 1 ? "md" : "sm"
                      }
                      variant={
                        index % 3 === 0
                          ? "cybersecurity"
                          : index % 3 === 1
                            ? "professional"
                            : "default"
                      }
                    />
                  ))
              }
            </div>
          </StaggerChildren>
        </div>
      </div>
    </section>

    <!-- Animations Section -->
    <section id="animations" class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Animation Components
        </h2>
      </FadeIn>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Fade In Animation -->
        <div class="text-center">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Fade In
          </h3>
          <FadeIn client:load>
            <div class="p-6 bg-primary/10 dark:bg-primary/30 rounded-lg">
              <div class="w-16 h-16 bg-primary rounded-full mx-auto mb-4"></div>
              <p class="text-gray-700 dark:text-gray-300">
                Content fades in smoothly
              </p>
            </div>
          </FadeIn>
        </div>

        <!-- Slide In Animation -->
        <div class="text-center">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Slide In
          </h3>
          <SlideIn client:load direction="up">
            <div class="p-6 bg-green-100 dark:bg-green-900/30 rounded-lg">
              <div class="w-16 h-16 bg-green-500 rounded-full mx-auto mb-4">
              </div>
              <p class="text-gray-700 dark:text-gray-300">
                Content slides in from direction
              </p>
            </div>
          </SlideIn>
        </div>

        <!-- Scale In Animation -->
        <div class="text-center">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Scale In
          </h3>
          <ScaleIn client:load>
            <div class="p-6 bg-chart-2/10 rounded-lg">
              <div class="w-16 h-16 bg-chart-2 rounded-full mx-auto mb-4"></div>
              <p class="text-gray-700 dark:text-gray-300">
                Content scales in with bounce
              </p>
            </div>
          </ScaleIn>
        </div>
      </div>

      <!-- Stagger Children Example -->
      <div class="mt-8">
        <h3
          class="text-lg font-semibold text-gray-900 dark:text-white mb-4 text-center"
        >
          Staggered Animation
        </h3>
        <StaggerChildren client:load>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {
              Array.from({ length: 8 }, (_, i) => (
                <div class="p-4 bg-gray-100 dark:bg-gray-800 rounded-lg text-center">
                  <div class="w-8 h-8 bg-gradient-to-r from-pink-500 to-violet-500 rounded-full mx-auto mb-2" />
                  <span class="text-sm text-gray-600 dark:text-gray-400">
                    Item {i + 1}
                  </span>
                </div>
              ))
            }
          </div>
        </StaggerChildren>
      </div>
    </section>

    <!-- Interactive Elements Section -->
    <section id="interactive" class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Interactive Elements
        </h2>
      </FadeIn>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Search Component -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
            Search Component
          </h3>
          <SlideIn client:load direction="left">
            <div
              class="p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg"
            >
              <Search client:load searchList={searchList} />
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-4">
                Interactive search with real-time filtering and keyboard
                navigation.
              </p>
            </div>
          </SlideIn>
        </div>

        <!-- Theme Toggle -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
            Theme Controls
          </h3>
          <SlideIn client:load direction="right">
            <div
              class="p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg"
            >
              <div class="flex items-center justify-center space-x-4">
                <ThemeToggle />
                <span class="text-sm text-gray-600 dark:text-gray-400">
                  Toggle between light and dark themes
                </span>
              </div>
            </div>
          </SlideIn>
        </div>
      </div>
    </section>

    <!-- Testing & Validation Section -->
    <section class="mb-12">
      <FadeIn client:load>
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center"
        >
          Quality Assurance
        </h2>
      </FadeIn>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Accessibility -->
        <ScaleIn client:load>
          <div
            class="p-6 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-center"
          >
            <div
              class="w-12 h-12 bg-green-500 rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3
              class="text-lg font-semibold text-green-700 dark:text-green-300 mb-2"
            >
              Accessibility Compliant
            </h3>
            <p class="text-sm text-green-600 dark:text-green-400">
              WCAG 2.1 AA compliant with proper ARIA labels and keyboard
              navigation.
            </p>
          </div>
        </ScaleIn>

        <!-- Performance -->
        <ScaleIn client:load delay={100}>
          <div
            class="p-6 bg-primary/10 dark:bg-primary/20 border border-primary/20 dark:border-primary/40 rounded-lg text-center"
          >
            <div
              class="w-12 h-12 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3
              class="text-lg font-semibold text-primary dark:text-primary/80 mb-2"
            >
              Optimized Performance
            </h3>
            <p class="text-sm text-primary/80 dark:text-primary/60">
              Lazy loading, code splitting, and optimized animations for smooth
              performance.
            </p>
          </div>
        </ScaleIn>

        <!-- Responsive -->
        <ScaleIn client:load delay={200}>
          <div
            class="p-6 bg-chart-2/10 border border-chart-2/20 rounded-lg text-center"
          >
            <div
              class="w-12 h-12 bg-chart-2 rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-chart-2 mb-2">
              Fully Responsive
            </h3>
            <p class="text-sm text-chart-2/80">
              Responsive design tested across all device sizes and orientations.
            </p>
          </div>
        </ScaleIn>
      </div>
    </section>

    <!-- Action Section -->
    <section class="text-center">
      <FadeIn client:load>
        <div
          class="bg-gradient-to-r from-primary to-chart-2 rounded-lg p-8 text-white"
        >
          <h2 class="text-2xl font-bold mb-4">Ready to Test?</h2>
          <p class="text-primary-foreground/80 mb-6">
            Explore the comprehensive testing suite to validate all components
            and ensure production readiness.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/testing/suite"
              class="px-6 py-3 bg-white text-primary rounded-lg hover:bg-primary/10 transition-colors font-medium"
            >
              Run Testing Suite
            </a>
            <a
              href="/testing/responsive"
              class="px-6 py-3 bg-primary text-white border border-white rounded-lg hover:bg-primary/90 transition-colors font-medium"
            >
              Test Responsive Design
            </a>
          </div>
        </div>
      </FadeIn>
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  /* Showcase-specific styles */
  section {
    scroll-margin-top: 2rem;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Grid animations */
  .grid > * {
    transition: transform 0.2s ease;
  }

  .grid > *:hover {
    transform: translateY(-2px);
  }

  /* Enhanced focus states for showcase */
  a:focus,
  button:focus {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
