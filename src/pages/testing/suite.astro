---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";

export const prerender = true;

const pageTitle = "Testing Suite - Component Validation";
const pageDescription =
  "Comprehensive testing suite for validating component functionality, accessibility, performance, and responsive design";
---

<Layout
  title={pageTitle}
  author={SITE.author}
  description={pageDescription}
  ogImage={SITE.ogImage}
>
  <Header activeNav="about" />
  <Main
    pageTitle="Testing Suite"
    titleTransition="testing"
    pageDesc="Comprehensive validation of all blog components with interactive testing tools"
  >
    <!-- Testing Suite Container -->
    <div class="space-y-8">
      <!-- Introduction -->
      <section
        class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
      >
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
          Component Testing Suite
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          This comprehensive testing suite validates all blog components for
          functionality, accessibility, performance, and responsive design. Use
          the interactive tools below to test components across different
          scenarios and ensure production readiness.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
          <div
            class="text-center p-4 bg-primary/10 dark:bg-primary/20 rounded-lg"
          >
            <div class="text-2xl font-bold text-primary">5+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">
              Testing Tools
            </div>
          </div>
          <div
            class="text-center p-4 bg-green-50 dark:bg-green-900/20 rounded-lg"
          >
            <div class="text-2xl font-bold text-green-600">25+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">
              Components
            </div>
          </div>
          <div
            class="text-center p-4 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg"
          >
            <div class="text-2xl font-bold text-yellow-600">50+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">
              Test Cases
            </div>
          </div>
          <div
            class="text-center p-4 bg-purple-50 dark:bg-purple-900/20 rounded-lg"
          >
            <div class="text-2xl font-bold text-purple-600">7</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">
              Breakpoints
            </div>
          </div>
        </div>
      </section>

      <!-- Blog Card Testing -->
      <section id="blogcard-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          BlogCard Component Testing
        </h3>
        <div id="blogcard-component-tester"></div>
      </section>

      <!-- Search Component Testing -->
      <section id="search-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Search Component Testing
        </h3>
        <div id="search-component-tester"></div>
      </section>

      <!-- Navigation Testing -->
      <section id="navigation-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Navigation Component Testing
        </h3>
        <div id="navigation-component-tester"></div>
      </section>

      <!-- Author Components Testing -->
      <section id="author-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Author Components Testing
        </h3>
        <div id="author-component-tester"></div>
      </section>

      <!-- Tag Components Testing -->
      <section id="tag-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Tag Components Testing
        </h3>
        <div id="tag-component-tester"></div>
      </section>

      <!-- Animation Components Testing -->
      <section id="animation-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Animation Components Testing
        </h3>
        <div id="animation-component-tester"></div>
      </section>

      <!-- Responsive Design Testing -->
      <section id="responsive-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Responsive Design Testing
        </h3>
        <div id="responsive-design-checker"></div>
      </section>

      <!-- Accessibility Testing -->
      <section id="accessibility-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Accessibility Testing
        </h3>
        <div id="accessibility-tester"></div>
      </section>

      <!-- Performance Testing -->
      <section id="performance-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Performance Testing
        </h3>
        <div id="performance-tester"></div>
      </section>

      <!-- Theme Testing -->
      <section id="theme-testing">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Theme Testing
        </h3>
        <div id="theme-tester"></div>
      </section>

      <!-- Test Results Summary -->
      <section
        id="test-summary"
        class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6"
      >
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Testing Summary
        </h3>
        <div id="test-summary-content">
          <p class="text-gray-600 dark:text-gray-400">
            Run tests above to see overall testing results and recommendations.
          </p>
        </div>
      </section>

      <!-- Quick Actions -->
      <section
        class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
      >
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Quick Actions
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <button
            id="run-all-tests"
            class="px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
          >
            Run All Tests
          </button>
          <button
            id="export-results"
            class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
          >
            Export Results
          </button>
          <a
            href="/testing/showcase"
            class="inline-block px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors text-center"
          >
            View Showcase
          </a>
        </div>
      </section>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  import React from "react";
  import { createRoot } from "react-dom/client";

  // Import testing components
  import {
    ComponentTester,
    ResponsiveDesignChecker,
    AccessibilityTester,
    PerformanceTester,
    ThemeTester,
    createDefaultTests,
  } from "@components/testing";

  // Import components to test
  import BlogCard from "@components/BlogCard";
  import Search from "@components/Search";
  import NavigationMenuHeader from "@components/NavigationMenuHeader";
  import { AuthorCard, AuthorBio } from "@components/author";
  import { TagCloud, EnhancedTag } from "@components/tags";
  import { FadeIn, SlideIn, ScaleIn } from "@components/animations";

  // Initialize testing suite when DOM is ready
  document.addEventListener("DOMContentLoaded", () => {
    // BlogCard Testing
    const blogCardContainer = document.getElementById(
      "blogcard-component-tester"
    );
    if (blogCardContainer) {
      const root = createRoot(blogCardContainer);
      root.render(
        React.createElement(ComponentTester, {
          componentName: "BlogCard",
          testComponent: BlogCard,
          testProps: {
            href: "/posts/test-post",
            frontmatter: {
              title: "Test Blog Post",
              description: "This is a test blog post for component testing",
              pubDatetime: new Date("2024-01-01"),
              tags: ["test", "blog", "component"],
              author: "Test Author",
            },
          },
          tests: [
            {
              name: "Renders",
              description: "BlogCard should render without errors",
              test: (element: HTMLElement) => {
                return element !== null;
              },
              expectation: "Component should render successfully",
            },
            {
              name: "Link Functionality",
              description: "BlogCard should have proper link attributes",
              test: (element: HTMLElement) => {
                const link = element.querySelector("a");
                return link && link.href.includes("/posts/test-post");
              },
              expectation: "Card should contain a link to the post",
            },
            {
              name: "Content Display",
              description: "BlogCard should display title and description",
              test: (element: HTMLElement) => {
                const title = element.textContent?.includes("Test Blog Post");
                const description = element.textContent?.includes(
                  "This is a test blog post"
                );
                return title && description;
              },
              expectation: "Card should show title and description",
            },
          ],
        })
      );
    }

    // Search Component Testing
    const searchContainer = document.getElementById("search-component-tester");
    if (searchContainer) {
      const root = createRoot(searchContainer);
      root.render(
        React.createElement(ComponentTester, {
          componentName: "Search",
          testComponent: Search,
          testProps: {},
          tests: [
            {
              name: "Renders",
              description: "Search should render without errors",
              test: (element: HTMLElement) => {
                return element !== null;
              },
              expectation: "Component should render successfully",
            },
            {
              name: "Input Functionality",
              description: "Search input should accept text",
              test: (element: HTMLElement) => {
                const input = element.querySelector(
                  'input[type="text"], input[type="search"]'
                );
                return input !== null;
              },
              expectation: "Search should have an input field",
            },
            {
              name: "Keyboard Navigation",
              description: "Search should support keyboard navigation",
              test: (element: HTMLElement) => {
                const input = element.querySelector("input");
                return input && input.getAttribute("aria-label") !== null;
              },
              expectation: "Search input should have proper ARIA labels",
            },
          ],
        })
      );
    }

    // Navigation Testing
    const navigationContainer = document.getElementById(
      "navigation-component-tester"
    );
    if (navigationContainer) {
      const root = createRoot(navigationContainer);
      root.render(
        React.createElement(ComponentTester, {
          componentName: "NavigationMenuHeader",
          testComponent: NavigationMenuHeader,
          testProps: {},
          tests: createDefaultTests("NavigationMenuHeader"),
        })
      );
    }

    // Author Components Testing
    const authorContainer = document.getElementById("author-component-tester");
    if (authorContainer) {
      const root = createRoot(authorContainer);
      root.render(
        React.createElement("div", { className: "space-y-6" }, [
          React.createElement(ComponentTester, {
            key: "author-card",
            componentName: "AuthorCard",
            testComponent: AuthorCard,
            testProps: {
              author: {
                name: "Test Author",
                bio: "A test author for component testing",
                avatar: "/assets/test-avatar.jpg",
                social: {
                  twitter: "@testauthor",
                  github: "testauthor",
                },
              },
            },
            tests: createDefaultTests("AuthorCard"),
          }),
          React.createElement(ComponentTester, {
            key: "author-bio",
            componentName: "AuthorBio",
            testComponent: AuthorBio,
            testProps: {
              author: {
                name: "Test Author",
                bio: "A comprehensive bio for testing the AuthorBio component with longer text content.",
                avatar: "/assets/test-avatar.jpg",
              },
            },
            tests: createDefaultTests("AuthorBio"),
          }),
        ])
      );
    }

    // Tag Components Testing
    const tagContainer = document.getElementById("tag-component-tester");
    if (tagContainer) {
      const root = createRoot(tagContainer);
      root.render(
        React.createElement("div", { className: "space-y-6" }, [
          React.createElement(ComponentTester, {
            key: "tag-cloud",
            componentName: "TagCloud",
            testComponent: TagCloud,
            testProps: {
              tags: [
                { name: "react", count: 15 },
                { name: "typescript", count: 12 },
                { name: "javascript", count: 20 },
                { name: "css", count: 8 },
                { name: "html", count: 6 },
              ],
            },
            tests: createDefaultTests("TagCloud"),
          }),
          React.createElement(ComponentTester, {
            key: "enhanced-tag",
            componentName: "EnhancedTag",
            testComponent: EnhancedTag,
            testProps: {
              tag: { name: "test-tag", count: 5 },
              size: "medium",
              variant: "default",
            },
            tests: createDefaultTests("EnhancedTag"),
          }),
        ])
      );
    }

    // Animation Components Testing
    const animationContainer = document.getElementById(
      "animation-component-tester"
    );
    if (animationContainer) {
      const root = createRoot(animationContainer);
      root.render(
        React.createElement("div", { className: "space-y-6" }, [
          React.createElement(ComponentTester, {
            key: "fade-in",
            componentName: "FadeIn",
            testComponent: FadeIn,
            testProps: {
              children: React.createElement(
                "div",
                {},
                "Fade In Animation Test"
              ),
            },
            tests: createDefaultTests("FadeIn"),
          }),
          React.createElement(ComponentTester, {
            key: "slide-in",
            componentName: "SlideIn",
            testComponent: SlideIn,
            testProps: {
              direction: "left",
              children: React.createElement(
                "div",
                {},
                "Slide In Animation Test"
              ),
            },
            tests: createDefaultTests("SlideIn"),
          }),
          React.createElement(ComponentTester, {
            key: "scale-in",
            componentName: "ScaleIn",
            testComponent: ScaleIn,
            testProps: {
              children: React.createElement(
                "div",
                {},
                "Scale In Animation Test"
              ),
            },
            tests: createDefaultTests("ScaleIn"),
          }),
        ])
      );
    }

    // Responsive Design Testing
    const responsiveContainer = document.getElementById(
      "responsive-design-checker"
    );
    if (responsiveContainer) {
      const root = createRoot(responsiveContainer);
      root.render(
        React.createElement(ResponsiveDesignChecker, {
          children: React.createElement(
            "div",
            { className: "p-4 bg-white dark:bg-gray-800 rounded" },
            [
              React.createElement(
                "h3",
                { key: "title", className: "text-lg font-semibold mb-2" },
                "Responsive Test Content"
              ),
              React.createElement(
                "p",
                {
                  key: "desc",
                  className: "text-gray-600 dark:text-gray-400 mb-4",
                },
                "This content tests responsive behavior across different screen sizes."
              ),
              React.createElement(
                "button",
                {
                  key: "btn",
                  className:
                    "px-4 py-2 bg-primary text-primary-foreground rounded hover:bg-primary/90",
                },
                "Test Button"
              ),
            ]
          ),
        })
      );
    }

    // Accessibility Testing
    const accessibilityContainer = document.getElementById(
      "accessibility-tester"
    );
    if (accessibilityContainer) {
      const root = createRoot(accessibilityContainer);
      root.render(
        React.createElement(AccessibilityTester, {
          autoTest: true,
          children: React.createElement("div", { className: "space-y-4" }, [
            React.createElement(
              "h3",
              { key: "heading" },
              "Accessibility Test Content"
            ),
            React.createElement(
              "p",
              { key: "text" },
              "This content tests accessibility compliance."
            ),
            React.createElement(
              "button",
              {
                key: "button",
                "aria-label": "Test button for accessibility",
              },
              "Accessible Button"
            ),
            React.createElement("img", {
              key: "image",
              src: "/assets/test-image.jpg",
              alt: "Test image with proper alt text",
            }),
            React.createElement("input", {
              key: "input",
              type: "text",
              id: "test-input",
              "aria-label": "Test input field",
            }),
            React.createElement(
              "label",
              {
                key: "label",
                htmlFor: "test-input",
              },
              "Test Label"
            ),
          ]),
        })
      );
    }

    // Performance Testing
    const performanceContainer = document.getElementById("performance-tester");
    if (performanceContainer) {
      const root = createRoot(performanceContainer);
      root.render(
        React.createElement(PerformanceTester, {
          componentName: "TestComponent",
          options: {
            trackRenders: true,
            trackMemory: true,
            trackFPS: true,
            duration: 3000,
          },
          children: React.createElement("div", { className: "space-y-4" }, [
            React.createElement(
              "h3",
              { key: "title" },
              "Performance Test Component"
            ),
            React.createElement(
              "div",
              { key: "content", className: "grid grid-cols-3 gap-4" },
              Array.from({ length: 9 }, (_, i) =>
                React.createElement(
                  "div",
                  {
                    key: i,
                    className:
                      "p-4 bg-primary/10 dark:bg-primary/20 rounded animate-pulse",
                  },
                  `Item ${i + 1}`
                )
              )
            ),
          ]),
        })
      );
    }

    // Theme Testing
    const themeContainer = document.getElementById("theme-tester");
    if (themeContainer) {
      const root = createRoot(themeContainer);
      root.render(
        React.createElement(ThemeTester, {
          autoTest: true,
          children: React.createElement(
            "div",
            {
              className:
                "space-y-4 p-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-white",
            },
            [
              React.createElement(
                "h3",
                { key: "title", className: "text-lg font-semibold" },
                "Theme Test Content"
              ),
              React.createElement(
                "p",
                { key: "text", className: "text-gray-600 dark:text-gray-400" },
                "This content tests theme switching capabilities."
              ),
              React.createElement(
                "button",
                {
                  key: "button",
                  className:
                    "px-4 py-2 bg-primary text-primary-foreground rounded hover:bg-primary/90",
                },
                "Theme-aware Button"
              ),
              React.createElement(
                "div",
                {
                  key: "card",
                  className:
                    "p-4 bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded",
                },
                "Theme-aware Card"
              ),
            ]
          ),
        })
      );
    }

    // Run All Tests Button
    const runAllButton = document.getElementById("run-all-tests");
    if (runAllButton) {
      runAllButton.addEventListener("click", () => {
        console.log("Running all tests...");
        // Trigger all test runners
        document.querySelectorAll("button").forEach(button => {
          if (
            button.textContent?.includes("Run Test") ||
            button.textContent?.includes("Test All")
          ) {
            button.click();
          }
        });
      });
    }

    // Export Results Button
    const exportButton = document.getElementById("export-results");
    if (exportButton) {
      exportButton.addEventListener("click", () => {
        const results = {
          timestamp: new Date().toISOString(),
          testResults: "Test results would be collected here",
          summary: "Overall testing summary",
        };

        const blob = new Blob([JSON.stringify(results, null, 2)], {
          type: "application/json",
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `test-results-${new Date().toISOString().split("T")[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }
  });
</script>

<style>
  /* Testing-specific styles */
  .testing-section {
    scroll-margin-top: 2rem;
  }

  /* Smooth scrolling for navigation */
  html {
    scroll-behavior: smooth;
  }

  /* Enhanced focus indicators for testing */
  button:focus,
  input:focus,
  select:focus {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
</style>
