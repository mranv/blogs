---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Tag from "@components/Tag.astro";
import getUniqueTags from "@utils/getUniqueTags";
import { SITE } from "@config";

const posts = await getCollection("blog");
let tags = getUniqueTags(posts);
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header activeNav="tags" />

  <!-- Clean production tags page -->
  <main class="tags-page">
    <div class="tags-header">
      <h1>Tags</h1>
      <p>All the tags used in posts ({tags.length} total)</p>

      <img
        src="/assets/7c19af9df1e0f73b7146c1d13b5520b8.gif"
        alt="Anubhav Gain"
        class="profile-image"
      />
    </div>

    <!-- All tags -->
    <ul class="tag-list">
      {tags.map(({ tag }) => <Tag {tag} size="lg" />)}
    </ul>
  </main>

  <Footer />
</Layout>

<style>
  .tags-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 60vh;
  }

  .tags-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .tags-header h1 {
    @apply text-4xl font-bold mb-4;
    background: linear-gradient(
      135deg,
      rgb(var(--color-gradient-start)),
      rgb(var(--color-gradient-end))
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tags-header p {
    @apply text-lg mb-6;
    color: rgb(var(--color-text-base));
    opacity: 0.8;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .profile-image {
    display: block;
    margin: 0 auto 2rem;
    border-radius: 50%;
    border: 3px solid rgb(var(--color-accent));
    width: 200px;
    height: 200px;
    object-fit: cover;
    box-shadow: 0 8px 32px rgba(var(--color-accent), 0.3);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .profile-image:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 48px rgba(var(--color-accent), 0.4);
  }

  /* Enhanced theme-specific styling */
  :global(html[data-theme="light"]) .tags-header h1 {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(html[data-theme="dark"]) .tags-header h1 {
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(html[data-theme="light"]) .tags-header p {
    color: rgb(17, 24, 39);
  }

  :global(html[data-theme="dark"]) .tags-header p {
    color: rgb(243, 244, 246);
  }

  /* Clean tag list styling */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    justify-content: center;
    align-items: center;
    max-width: 100%;
  }

  .tag-list li {
    display: inline-block;
  }

  /* Ensure tag visibility and theme transitions */
  .tag-list li a {
    display: inline-flex !important;
    align-items: center !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* Theme transition support for entire page */
  .tags-page,
  .tags-page * {
    transition:
      color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Enhanced theme-specific backgrounds */
  :global(html[data-theme="light"]) .tags-page {
    background: transparent;
  }

  :global(html[data-theme="dark"]) .tags-page {
    background: transparent;
  }

  /* Smooth theme transitions when theme-transition class is active */
  :global(.theme-transition) .tags-page,
  :global(.theme-transition) .tags-page *,
  :global(.theme-transition) .profile-image,
  :global(.theme-transition) .tags-header h1,
  :global(.theme-transition) .tags-header p {
    transition-duration: 0.4s !important;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .tags-page {
      padding: 1rem;
    }

    .tags-header h1 {
      @apply text-3xl;
    }

    .profile-image {
      width: 150px;
      height: 150px;
    }

    .tag-list {
      gap: 0.5rem;
    }
  }
</style>
