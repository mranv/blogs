---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import ShapeGrid from "../components/reactbits/ShapeGrid";
import ShinyText from "../components/reactbits/ShinyText";


const projectsPost = await getEntry("spec", "projects");

if (!projectsPost) {
	throw new Error("Projects page content not found");
}

const { Content, headings } = await render(projectsPost);

const pageTitle = "Open-Source Projects — Anubhav Gain";
const pageDescription = "Production-grade open-source projects by Anubhav Gain: Leviathan (Windows kernel EDR in Rust), Krustron (Kubernetes platform), Agni (Firecracker TUI), opensearch-rust-sdk, and more.";
---
<MainGridLayout title={pageTitle} description={pageDescription} headings={headings} art={false}>
    <!-- Page banner replaces the ASCII strip here. WebGL canvas: literal colours, see reactbits/README.md -->
    <div class="card-base relative mb-4 h-40 overflow-hidden" aria-hidden="true">
        <ShapeGrid client:visible lineColor="#807a73" hoverColor="#ce5e32" clickCascade={false} />
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none font-heading italic text-5xl">
            <ShinyText client:visible text="Projects" color="#958f87" shineColor="#ce5e32" speed={3} />
            <!-- Typed, held, taken back, next phrase (public/ink-type.js). Server text = first phrase. -->
            <div class="mt-3 h-4 font-mono not-italic text-[0.6875rem] tracking-[0.18em] uppercase text-[var(--ink-muted)]"
                 data-ink-cycle={JSON.stringify(["Leviathan · Windows kernel EDR in Rust", "Krustron · a Kubernetes platform", "Agni · a Firecracker TUI", "opensearch-rust-sdk"])}>Leviathan · Windows kernel EDR in Rust</div>
        </div>
    </div>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
