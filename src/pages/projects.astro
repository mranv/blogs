---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const projectsPost = await getEntry("spec", "projects");

if (!projectsPost) {
	throw new Error("Projects page content not found");
}

const { Content } = await render(projectsPost);

const pageTitle = "Open-Source Projects — Anubhav Gain";
const pageDescription = "Production-grade open-source projects by Anubhav Gain: Leviathan (Windows kernel EDR in Rust), Krustron (Kubernetes platform), Agni (Firecracker TUI), opensearch-rust-sdk, and more.";
---
<MainGridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
